<Project Sdk="Microsoft.NET.Sdk">
 <PropertyGroup>
  <OutputType>WinExe</OutputType><TargetFramework>net10.0-windows10.0.19041.0</TargetFramework><TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
  <RuntimeIdentifier>win-x64</RuntimeIdentifier><PlatformTarget>x64</PlatformTarget><UseWinUI>true</UseWinUI><WindowsPackageType>None</WindowsPackageType><WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
  <ApplicationManifest>../../app/app.manifest</ApplicationManifest><EnableDefaultCompileItems>false</EnableDefaultCompileItems><EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
  <OutputControlSource Condition="'$(OutputControlSource)' == ''">../../app/CommandOutputView.cs</OutputControlSource>
 </PropertyGroup>
 <ItemGroup>
  <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260921001" />
  <ProjectReference Include="../../core/TidyWindow.Core.csproj" />
  <Compile Include="Program.cs" /><Compile Include="$(OutputControlSource)" Link="CommandOutputView.cs" /><Compile Include="../../app/BrushCache.cs" Link="BrushCache.cs" />
  <Compile Include="../../app/ScoutViewModel.cs" Link="ScoutViewModel.cs" /><Compile Include="../../app/BulkObservableCollection.cs" Link="BulkObservableCollection.cs" />
  <Compile Include="../../app/ObservableState.cs" Link="ObservableState.cs" />
  <Page Remove="App.xaml" /><ApplicationDefinition Include="App.xaml" />
 </ItemGroup>
</Project>
