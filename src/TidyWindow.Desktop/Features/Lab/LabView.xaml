<UserControl x:Class="TidyWindow.Next.Desktop.LabView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="using:TidyWindow.Next.Desktop"
 HorizontalContentAlignment="Stretch">
 <UserControl.Resources>
  <ResourceDictionary>
   <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="ms-appx:///Styles/ListStyles.xaml" /><ResourceDictionary Source="ms-appx:///Styles/PageStyles.xaml" /></ResourceDictionary.MergedDictionaries>

   <!-- A small word with a hairline outline, used for the settings in force. -->
   <Style x:Key="Tag" TargetType="Border">
    <Setter Property="BorderBrush" Value="{ThemeResource LineBrush}" /><Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="10" /><Setter Property="Padding" Value="9,2" /><Setter Property="VerticalAlignment" Value="Center" />
   </Style>

   <!-- One measured number, with how it moved since the check before. -->
   <DataTemplate x:Key="MetricTemplate">
    <Border BorderBrush="{ThemeResource LineBrush}" BorderThickness="0,0,0,1" Padding="0,12">
     <Grid ColumnSpacing="16">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="210" /><ColumnDefinition Width="170" /></Grid.ColumnDefinitions>
      <StackPanel Spacing="2" VerticalAlignment="Center">
       <TextBlock Text="{Binding Name}" Style="{StaticResource ItemTitle}" />
       <TextBlock Text="{Binding What}" Style="{StaticResource RowSub}" TextWrapping="Wrap" TextTrimming="None" />
      </StackPanel>
      <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
       <TextBlock Text="{Binding Value}" FontFamily="{StaticResource MonoFont}" FontSize="14" FontWeight="SemiBold" />
       <TextBlock Text="{Binding Steadiness}" FontSize="11" Foreground="{ThemeResource MutedBrush}" />
      </StackPanel>
      <Grid Grid.Column="2" VerticalAlignment="Center">
       <StackPanel Orientation="Horizontal" Spacing="7" Visibility="{Binding BetterVisibility}"><Ellipse Style="{StaticResource StateDot}" Fill="{ThemeResource GoodBrush}" /><TextBlock Text="{Binding ChangeText}" Foreground="{ThemeResource GoodBrush}" FontWeight="Medium" FontSize="13" /></StackPanel>
       <StackPanel Orientation="Horizontal" Spacing="7" Visibility="{Binding WorseVisibility}"><Ellipse Style="{StaticResource StateDot}" Fill="{ThemeResource WarnBrush}" /><TextBlock Text="{Binding ChangeText}" Foreground="{ThemeResource WarnBrush}" FontWeight="Medium" FontSize="13" /></StackPanel>
       <StackPanel Orientation="Horizontal" Spacing="7" Visibility="{Binding SameVisibility}"><Ellipse Style="{StaticResource StateDot}" Fill="{ThemeResource MutedBrush}" /><TextBlock Text="{Binding ChangeText}" Foreground="{ThemeResource MutedBrush}" FontSize="13" /></StackPanel>
      </Grid>
     </Grid>
    </Border>
   </DataTemplate>

   <DataTemplate x:Key="HistoryTemplate">
    <Grid ColumnSpacing="14" Margin="0,0,0,6">
     <Grid.ColumnDefinitions><ColumnDefinition Width="130" /><ColumnDefinition Width="260" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
     <TextBlock Text="{Binding When}" FontSize="12" Foreground="{ThemeResource MutedBrush}" />
     <TextBlock Grid.Column="1" Text="{Binding Settings}" FontSize="12" TextTrimming="CharacterEllipsis" />
     <TextBlock Grid.Column="2" Text="{Binding Numbers}" FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="{ThemeResource MutedBrush}" TextTrimming="CharacterEllipsis" />
    </Grid>
   </DataTemplate>

   <!-- An app, and a three-way choice that always shows which one is in force. -->
   <DataTemplate x:Key="AppTemplate">
    <Border BorderBrush="{ThemeResource LineBrush}" BorderThickness="0,0,0,1">
     <Grid Padding="20,10" MinHeight="58" ColumnSpacing="16">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <StackPanel VerticalAlignment="Center" Spacing="2">
       <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBlock Text="{Binding Name}" Style="{StaticResource ItemTitle}" />
        <Border Visibility="{Binding ChangedVisibility}" Style="{StaticResource Tag}" ToolTipService.ToolTip="TidyWindow changed this app. It goes back by itself when the app closes."><TextBlock Text="Changed" FontSize="11" Foreground="{ThemeResource MutedBrush}" /></Border>
       </StackPanel>
       <TextBlock Text="{Binding Title}" Style="{StaticResource RowSub}" MaxLines="1" />
      </StackPanel>
      <TextBlock Grid.Column="1" Text="{Binding Memory}" FontSize="12" Foreground="{ThemeResource MutedBrush}" VerticalAlignment="Center" />
      <Border Grid.Column="2" BorderBrush="{ThemeResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="3" VerticalAlignment="Center">
       <StackPanel Orientation="Horizontal" Spacing="2">
        <RadioButton GroupName="{Binding GroupName}" IsChecked="{Binding IsEase, Mode=OneWay}" IsEnabled="{Binding CanChange}" Click="EaseClick" Content="Ease" Style="{StaticResource SegmentStyle}" ToolTipService.ToolTip="Give other things the processor first" AutomationProperties.Name="Ease this app" />
        <RadioButton GroupName="{Binding GroupName}" IsChecked="{Binding IsNormal, Mode=OneWay}" IsEnabled="{Binding CanChange}" Click="NormalClick" Content="Normal" Style="{StaticResource SegmentStyle}" ToolTipService.ToolTip="The way Windows starts it" AutomationProperties.Name="Normal priority for this app" />
        <RadioButton GroupName="{Binding GroupName}" IsChecked="{Binding IsBoost, Mode=OneWay}" IsEnabled="{Binding CanChange}" Click="BoostClick" Content="Boost" Style="{StaticResource SegmentStyle}" ToolTipService.ToolTip="Give this app the processor first" AutomationProperties.Name="Boost this app" />
       </StackPanel>
      </Border>
     </Grid>
    </Border>
   </DataTemplate>
  </ResourceDictionary>
 </UserControl.Resources>

 <Grid RowSpacing="16">
  <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>

  <StackPanel Spacing="4">
   <TextBlock Text="Lab" Style="{StaticResource PageTitle}" />
   <TextBlock Text="Measure what a change really does. Check, change one thing, check again." Style="{StaticResource Muted}" />
  </StackPanel>

  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" IsTabStop="False">
   <StackPanel Spacing="16" Margin="0,0,0,12">

    <!-- 1. Check this PC -->
    <Border Style="{StaticResource Card}" Padding="20">
     <StackPanel Spacing="16">
      <Grid ColumnSpacing="14">
       <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
       <Border Width="36" Height="36" CornerRadius="8" BorderThickness="1" BorderBrush="{ThemeResource LineBrush}" Background="{ThemeResource CanvasBrush}" VerticalAlignment="Top">
        <FontIcon Glyph="&#xE9D9;" FontSize="16" Foreground="{ThemeResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
       </Border>
       <StackPanel Grid.Column="1" Spacing="3">
        <TextBlock Text="Check this PC" Style="{StaticResource SectionTitle}" />
        <TextBlock Text="{Binding CheckIntro}" Style="{StaticResource Muted}" FontSize="12" />
       </StackPanel>
       <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
        <Button Click="StopClick" Visibility="{Binding RunningVisibility}" Padding="12,7" FontSize="12" Content="Stop" AutomationProperties.Name="Stop the check" />
        <Button Click="RunClick" IsEnabled="{Binding CanRun}" Style="{StaticResource PrimaryButton}" MinWidth="110" AutomationProperties.Name="Run the check">
         <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center"><FontIcon Glyph="&#xE768;" FontSize="11" /><TextBlock Text="{Binding RunText}" /></StackPanel>
        </Button>
       </StackPanel>
      </Grid>

      <!-- While it runs, every line it prints -->
      <Border Visibility="{Binding RunningVisibility}" Background="{ThemeResource CanvasBrush}" BorderBrush="{ThemeResource LineBrush}" BorderThickness="1" CornerRadius="6" Padding="14,12">
       <StackPanel Spacing="8">
        <StackPanel Orientation="Horizontal" Spacing="10"><ProgressRing IsActive="True" Width="14" Height="14" /><TextBlock Text="{Binding Live}" FontFamily="{StaticResource MonoFont}" FontSize="12" VerticalAlignment="Center" /></StackPanel>
        <ItemsControl ItemsSource="{Binding Lines}" IsTabStop="False">
         <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="{ThemeResource MutedBrush}" /></DataTemplate></ItemsControl.ItemTemplate>
        </ItemsControl>
       </StackPanel>
      </Border>

      <!-- Nothing measured yet -->
      <Border Visibility="{Binding NoResultVisibility}" BorderBrush="{ThemeResource LineBrush}" BorderThickness="1" CornerRadius="6" Padding="16,14" Background="{ThemeResource CanvasBrush}">
       <TextBlock Text="No check yet. Run one to see where this PC stands. It takes about 15 seconds." Style="{StaticResource Muted}" />
      </Border>

      <StackPanel Visibility="{Binding ResultVisibility}" Spacing="0">
       <!-- What was in force when it ran -->
       <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,12">
        <Border Style="{StaticResource Tag}"><TextBlock FontSize="11"><Run Text="Power plan " Foreground="{ThemeResource MutedBrush}" /><Run Text="{Binding ContextPlan}" /></TextBlock></Border>
        <Border Style="{StaticResource Tag}"><TextBlock FontSize="11"><Run Text="Memory integrity " Foreground="{ThemeResource MutedBrush}" /><Run Text="{Binding ContextMemory}" /></TextBlock></Border>
        <TextBlock Text="{Binding ContextWhen}" FontSize="12" Foreground="{ThemeResource MutedBrush}" VerticalAlignment="Center" />
       </StackPanel>
       <!-- Column headings -->
       <Grid ColumnSpacing="16" Padding="0,8" BorderBrush="{ThemeResource LineBrush}" BorderThickness="0,1,0,1">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="210" /><ColumnDefinition Width="170" /></Grid.ColumnDefinitions>
        <TextBlock Text="Test" Style="{StaticResource ColumnLabel}" />
        <TextBlock Grid.Column="1" Text="Result" Style="{StaticResource ColumnLabel}" />
        <TextBlock Grid.Column="2" Text="Since the last check" Style="{StaticResource ColumnLabel}" />
       </Grid>
       <ItemsControl ItemsSource="{Binding Metrics}" ItemTemplate="{StaticResource MetricTemplate}" IsTabStop="False" AutomationProperties.Name="Check results" />
       <TextBlock Visibility="{Binding CompareVisibility}" Text="{Binding CompareText}" FontSize="12" Foreground="{ThemeResource MutedBrush}" TextWrapping="Wrap" Margin="0,12,0,0" />
      </StackPanel>

      <StackPanel Visibility="{Binding HistoryVisibility}" Spacing="8">
       <Grid>
        <TextBlock Text="Earlier checks" Style="{StaticResource GroupLabel}" VerticalAlignment="Center" />
        <HyperlinkButton Click="ClearHistoryClick" HorizontalAlignment="Right" Padding="4,0" Content="Clear" FontSize="12" AutomationProperties.Name="Clear earlier checks" />
       </Grid>
       <ItemsControl ItemsSource="{Binding History}" ItemTemplate="{StaticResource HistoryTemplate}" IsTabStop="False" />
      </StackPanel>
     </StackPanel>
    </Border>

    <!-- 2. Power plan -->
    <Border Style="{StaticResource Card}" Padding="20">
     <Grid ColumnSpacing="14">
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <Border Width="36" Height="36" CornerRadius="8" BorderThickness="1" BorderBrush="{ThemeResource LineBrush}" Background="{ThemeResource CanvasBrush}" VerticalAlignment="Top">
       <FontIcon Glyph="&#xE945;" FontSize="16" Foreground="{ThemeResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
      </Border>
      <StackPanel Grid.Column="1" Spacing="6">
       <StackPanel Orientation="Horizontal" Spacing="10">
        <TextBlock Text="Power plan" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
        <Border Style="{StaticResource Tag}">
         <StackPanel Orientation="Horizontal" Spacing="7">
          <Ellipse Style="{StaticResource StateDot}" Visibility="{Binding PowerFastVisibility}" Fill="{ThemeResource GoodBrush}" />
          <Ellipse Style="{StaticResource StateDot}" Visibility="{Binding PowerNormalVisibility}" Fill="{ThemeResource MutedBrush}" />
          <TextBlock Text="{Binding PowerName}" FontSize="11" />
         </StackPanel>
        </Border>
       </StackPanel>
       <TextBlock Text="{Binding PowerText}" Style="{StaticResource Muted}" FontSize="12" />
       <TextBlock Visibility="{Binding PowerWarningVisibility}" Text="{Binding PowerWarning}" FontSize="12" Foreground="{ThemeResource WarnBrush}" TextWrapping="Wrap" />
      </StackPanel>
      <Button Grid.Column="2" Click="PowerClick" IsEnabled="{Binding PowerCanClick}" Padding="14,7" MinWidth="170" VerticalAlignment="Top" AutomationProperties.Name="Change the power plan">
       <TextBlock Text="{Binding PowerButton}" FontSize="12" HorizontalAlignment="Center" />
      </Button>
     </Grid>
    </Border>

    <!-- 3. Memory integrity: shown here because it matters for speed, changed in Tune where it can be undone -->
    <Border Style="{StaticResource Card}" Padding="20">
     <Grid ColumnSpacing="14">
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <Border Width="36" Height="36" CornerRadius="8" BorderThickness="1" BorderBrush="{ThemeResource LineBrush}" Background="{ThemeResource CanvasBrush}" VerticalAlignment="Top">
       <FontIcon Glyph="&#xEA18;" FontSize="16" Foreground="{ThemeResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
      </Border>
      <StackPanel Grid.Column="1" Spacing="6">
       <StackPanel Orientation="Horizontal" Spacing="10">
        <TextBlock Text="Memory integrity" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
        <Border Style="{StaticResource Tag}">
         <StackPanel Orientation="Horizontal" Spacing="7">
          <Ellipse Style="{StaticResource StateDot}" Visibility="{Binding MemoryOnVisibility}" Fill="{ThemeResource GoodBrush}" />
          <Ellipse Style="{StaticResource StateDot}" Visibility="{Binding MemoryOffVisibility}" Fill="{ThemeResource WarnBrush}" />
          <TextBlock Text="{Binding MemoryIntegrityState}" FontSize="11" />
         </StackPanel>
        </Border>
       </StackPanel>
       <TextBlock Text="{Binding MemoryIntegrityText}" Style="{StaticResource Muted}" FontSize="12" />
       <TextBlock Text="To see what it costs on this PC: run a check, turn it off in Tune, restart, then check again." FontSize="12" Foreground="{ThemeResource MutedBrush}" TextWrapping="Wrap" />
      </StackPanel>
      <Button Grid.Column="2" Click="TuneClick" Padding="14,7" MinWidth="120" VerticalAlignment="Top" AutomationProperties.Name="Open Tune to change memory integrity">
       <TextBlock Text="Open in Tune" FontSize="12" HorizontalAlignment="Center" />
      </Button>
     </Grid>
    </Border>

    <!-- 4. Apps -->
    <Border Style="{StaticResource Card}" Padding="0">
     <StackPanel>
      <Grid Padding="20,20,20,16" ColumnSpacing="14">
       <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
       <Border Width="36" Height="36" CornerRadius="8" BorderThickness="1" BorderBrush="{ThemeResource LineBrush}" Background="{ThemeResource CanvasBrush}" VerticalAlignment="Top">
        <FontIcon Glyph="&#xE81E;" FontSize="16" Foreground="{ThemeResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
       </Border>
       <StackPanel Grid.Column="1" Spacing="4">
        <TextBlock Text="App priority" Style="{StaticResource SectionTitle}" />
        <TextBlock Text="{Binding AppsNote}" Style="{StaticResource Muted}" FontSize="12" />
       </StackPanel>
       <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
        <Button Click="PutBackClick" Visibility="{Binding PutBackVisibility}" Padding="12,7" FontSize="12" Content="Put all back" AutomationProperties.Name="Put every changed app back" />
        <Button Click="RefreshClick" Padding="12,7" AutomationProperties.Name="Refresh the list of apps" ToolTipService.ToolTip="Refresh the list"><FontIcon Glyph="&#xE72C;" FontSize="12" /></Button>
       </StackPanel>
      </Grid>
      <Border BorderBrush="{ThemeResource LineBrush}" BorderThickness="0,1,0,0">
       <ItemsControl ItemsSource="{Binding Apps}" ItemTemplate="{StaticResource AppTemplate}" IsTabStop="False" AutomationProperties.Name="Running apps" />
      </Border>
     </StackPanel>
    </Border>

    <Grid ColumnSpacing="10" Margin="2,2,2,0">
     <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
     <FontIcon Glyph="&#xE946;" FontSize="13" Foreground="{ThemeResource MutedBrush}" VerticalAlignment="Top" Margin="0,2,0,0" />
     <TextBlock Grid.Column="1" Text="Only things with evidence behind them are here. Boot timer tweaks, pagefile presets, turning services off and pinning programs to certain cores are left out on purpose: they do not help, or help less than they cost. Nothing on this page changes the registry or needs administrator permission." Style="{StaticResource Muted}" FontSize="12" />
    </Grid>
   </StackPanel>
  </ScrollViewer>
 </Grid>
</UserControl>
