<UserControl x:Class="TidyWindow.Next.Desktop.LabView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="using:TidyWindow.Next.Desktop"
 HorizontalContentAlignment="Stretch">
 <UserControl.Resources>
  <ResourceDictionary>
   <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="ms-appx:///Styles/ListStyles.xaml" /><ResourceDictionary Source="ms-appx:///Styles/PageStyles.xaml" /></ResourceDictionary.MergedDictionaries>

   <!-- A small word with a hairline outline, used for the settings in force. -->
   <Style x:Key="Tag" TargetType="Border">
    <Setter Property="BorderBrush" Value="{ThemeResource LineBrush}" /><Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="10" /><Setter Property="Padding" Value="9,2" /><Setter Property="VerticalAlignment" Value="Center" />
   </Style>

   <!-- The square an icon sits in, at the left of a row. -->
   <Style x:Key="IconTile" TargetType="Border">
    <Setter Property="Width" Value="36" /><Setter Property="Height" Value="36" /><Setter Property="CornerRadius" Value="8" /><Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{ThemeResource LineBrush}" /><Setter Property="Background" Value="{ThemeResource CanvasBrush}" /><Setter Property="VerticalAlignment" Value="Top" />
   </Style>

   <!-- A line of small type above each part of the page, with what it is for. -->
   <Style x:Key="PartNote" TargetType="TextBlock" BasedOn="{StaticResource Muted}"><Setter Property="FontSize" Value="12" /></Style>

   <!-- One test: the number large, how it moved against the check being compared with, and where the rounds of both fell. -->
   <DataTemplate x:Key="MetricTemplate">
    <Border Style="{StaticResource Card}" Padding="16,13" ToolTipService.ToolTip="{Binding What}">
     <Grid RowSpacing="6">
      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
      <Grid ColumnSpacing="10">
       <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
       <TextBlock Text="{Binding Name}" Style="{StaticResource ItemTitle}" FontSize="13" Foreground="{ThemeResource MutedBrush}" VerticalAlignment="Center" />
       <Grid Grid.Column="1" VerticalAlignment="Center">
        <Border Visibility="{Binding BetterVisibility}" Background="{ThemeResource GoodSoftBrush}" CornerRadius="10" Padding="9,3"><StackPanel Orientation="Horizontal" Spacing="5"><FontIcon Glyph="&#xE74A;" FontSize="10" Foreground="{ThemeResource GoodBrush}" VerticalAlignment="Center" /><TextBlock Text="{Binding ChangeText}" Foreground="{ThemeResource GoodBrush}" FontSize="12" FontWeight="Medium" /></StackPanel></Border>
        <Border Visibility="{Binding WorseVisibility}" Background="{ThemeResource WarnSoftBrush}" CornerRadius="10" Padding="9,3"><StackPanel Orientation="Horizontal" Spacing="5"><FontIcon Glyph="&#xE74B;" FontSize="10" Foreground="{ThemeResource WarnBrush}" VerticalAlignment="Center" /><TextBlock Text="{Binding ChangeText}" Foreground="{ThemeResource WarnBrush}" FontSize="12" FontWeight="Medium" /></StackPanel></Border>
        <Border Visibility="{Binding SameVisibility}" Background="{ThemeResource BadgeBrush}" CornerRadius="10" Padding="9,3"><TextBlock Text="{Binding ChangeText}" Foreground="{ThemeResource MutedBrush}" FontSize="12" /></Border>
       </Grid>
      </Grid>
      <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="6">
       <TextBlock Text="{Binding Number}" FontFamily="{StaticResource MonoFont}" FontSize="26" FontWeight="SemiBold" CharacterSpacing="-20" />
       <TextBlock Text="{Binding Unit}" FontSize="12" Foreground="{ThemeResource MutedBrush}" VerticalAlignment="Bottom" Margin="0,0,0,5" />
      </StackPanel>
      <local:RangeBar Grid.Row="2" Before="{Binding Before}" After="{Binding After}" Visibility="{Binding BarVisibility}" />
      <StackPanel Grid.Row="3" Spacing="2" VerticalAlignment="Bottom">
       <TextBlock Text="{Binding Was}" FontSize="12" Visibility="{Binding ChangeVisibility}" TextTrimming="CharacterEllipsis" />
       <TextBlock Text="{Binding Detail}" Style="{StaticResource RowSub}" TextWrapping="Wrap" MaxLines="2" />
      </StackPanel>
     </Grid>
    </Border>
   </DataTemplate>

   <DataTemplate x:Key="ChipTemplate">
    <Border Style="{StaticResource Tag}"><TextBlock Text="{Binding}" FontSize="12" /></Border>
   </DataTemplate>

   <DataTemplate x:Key="NoticeTemplate">
    <Border Background="{ThemeResource WarnSoftBrush}" CornerRadius="6" Padding="14,10" Margin="0,0,0,8">
     <Grid ColumnSpacing="10">
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
      <FontIcon Glyph="&#xE7BA;" FontSize="14" Foreground="{ThemeResource WarnBrush}" VerticalAlignment="Top" Margin="0,2,0,0" />
      <TextBlock Grid.Column="1" Text="{Binding}" FontSize="13" Foreground="{ThemeResource WarnBrush}" TextWrapping="Wrap" />
     </Grid>
    </Border>
   </DataTemplate>

   <!-- An earlier check. Newer-version checks can be picked as the one to compare with; older ones are only listed. -->
   <DataTemplate x:Key="HistoryTemplate">
    <Border BorderBrush="{ThemeResource LineBrush}" BorderThickness="0,1,0,0" MinHeight="44">
     <Grid>
      <!-- The check being compared with is picked out, so the table says which one the answer above is about. -->
      <Border Visibility="{Binding BaselineVisibility}" Background="{ThemeResource RowHoverBrush}" />
      <Grid Padding="20,0" ColumnSpacing="12" Opacity="{Binding Fade}">
       <Grid.ColumnDefinitions>
        <ColumnDefinition Width="150" /><ColumnDefinition Width="*" /><ColumnDefinition Width="110" />
        <ColumnDefinition Width="76" /><ColumnDefinition Width="76" /><ColumnDefinition Width="76" /><ColumnDefinition Width="76" /><ColumnDefinition Width="110" />
       </Grid.ColumnDefinitions>
       <TextBlock Text="{Binding When}" FontSize="12" VerticalAlignment="Center" />
       <TextBlock Grid.Column="1" Text="{Binding Plan}" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
       <TextBlock Grid.Column="2" Text="{Binding Memory}" FontSize="12" VerticalAlignment="Center" />
       <TextBlock Grid.Column="3" Text="{Binding Wake}" FontFamily="{StaticResource MonoFont}" FontSize="12" TextAlignment="Right" VerticalAlignment="Center" />
       <TextBlock Grid.Column="4" Text="{Binding Work}" FontFamily="{StaticResource MonoFont}" FontSize="12" TextAlignment="Right" VerticalAlignment="Center" />
       <TextBlock Grid.Column="5" Text="{Binding Copy}" FontFamily="{StaticResource MonoFont}" FontSize="12" TextAlignment="Right" VerticalAlignment="Center" />
       <TextBlock Grid.Column="6" Text="{Binding Access}" FontFamily="{StaticResource MonoFont}" FontSize="12" TextAlignment="Right" VerticalAlignment="Center" />
       <Grid Grid.Column="7" HorizontalAlignment="Right" VerticalAlignment="Center">
        <Button Click="CompareClick" Visibility="{Binding CanCompareVisibility}" Padding="12,4" FontSize="12" Content="Compare" AutomationProperties.Name="Compare the newest check with this one" />
        <Border Style="{StaticResource Tag}" Visibility="{Binding BaselineVisibility}"><TextBlock Text="Comparing" FontSize="11" FontWeight="Medium" /></Border>
        <TextBlock Text="Older tests" Visibility="{Binding OldVisibility}" FontSize="11" Foreground="{ThemeResource MutedBrush}" ToolTipService.ToolTip="Made by an older version of the tests, so it cannot be compared." />
       </Grid>
      </Grid>
     </Grid>
    </Border>
   </DataTemplate>

   <!-- An app, and a three-way choice that always shows which one is in force. -->
   <DataTemplate x:Key="AppTemplate">
    <Border BorderBrush="{ThemeResource LineBrush}" BorderThickness="0,0,0,1">
     <Grid Padding="20,10" MinHeight="58" ColumnSpacing="16">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <StackPanel VerticalAlignment="Center" Spacing="2">
       <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBlock Text="{Binding Name}" Style="{StaticResource ItemTitle}" />
        <Border Visibility="{Binding ChangedVisibility}" Style="{StaticResource Tag}" ToolTipService.ToolTip="TidyWindow changed this app. It goes back by itself when the app closes."><TextBlock Text="Changed" FontSize="11" Foreground="{ThemeResource MutedBrush}" /></Border>
       </StackPanel>
       <TextBlock Text="{Binding Title}" Style="{StaticResource RowSub}" MaxLines="1" />
      </StackPanel>
      <TextBlock Grid.Column="1" Text="{Binding Memory}" FontFamily="{StaticResource MonoFont}" FontSize="12" Foreground="{ThemeResource MutedBrush}" VerticalAlignment="Center" />
      <Border Grid.Column="2" BorderBrush="{ThemeResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="3" VerticalAlignment="Center">
       <StackPanel Orientation="Horizontal" Spacing="2">
        <RadioButton GroupName="{Binding GroupName}" IsChecked="{Binding IsEase, Mode=OneWay}" IsEnabled="{Binding CanChange}" Click="EaseClick" Content="Ease" Style="{StaticResource SegmentStyle}" ToolTipService.ToolTip="Give other things the processor first" AutomationProperties.Name="Ease this app" />
        <RadioButton GroupName="{Binding GroupName}" IsChecked="{Binding IsNormal, Mode=OneWay}" IsEnabled="{Binding CanChange}" Click="NormalClick" Content="Normal" Style="{StaticResource SegmentStyle}" ToolTipService.ToolTip="The way Windows starts it" AutomationProperties.Name="Normal priority for this app" />
        <RadioButton GroupName="{Binding GroupName}" IsChecked="{Binding IsBoost, Mode=OneWay}" IsEnabled="{Binding CanChange}" Click="BoostClick" Content="Boost" Style="{StaticResource SegmentStyle}" ToolTipService.ToolTip="Give this app the processor first" AutomationProperties.Name="Boost this app" />
       </StackPanel>
      </Border>
     </Grid>
    </Border>
   </DataTemplate>
  </ResourceDictionary>
 </UserControl.Resources>

 <Grid RowSpacing="16">
  <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>

  <StackPanel Spacing="4">
   <TextBlock Text="Lab" Style="{StaticResource PageTitle}" />
   <TextBlock Text="Measure what a change really does. Check, change one thing, check again." Style="{StaticResource Muted}" />
  </StackPanel>

  <ScrollViewer Grid.Row="1" Style="{StaticResource PageScrollViewerStyle}" VerticalScrollBarVisibility="Auto" IsTabStop="False">
   <StackPanel Spacing="32" Margin="0,0,0,12">

    <!-- 1. The check -->
    <StackPanel Spacing="12">
     <Grid ColumnSpacing="14">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <StackPanel Spacing="3" VerticalAlignment="Center">
       <TextBlock Text="Check this PC" Style="{StaticResource SectionTitle}" />
       <TextBlock Text="{Binding CheckIntro}" Style="{StaticResource PartNote}" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
       <Button Click="StopClick" Visibility="{Binding RunningVisibility}" Padding="12,7" FontSize="12" Content="Stop" AutomationProperties.Name="Stop the check" />
       <Button Click="RunClick" IsEnabled="{Binding CanRun}" Style="{StaticResource PrimaryButton}" MinWidth="120" AutomationProperties.Name="Run the check">
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center"><FontIcon Glyph="&#xE768;" FontSize="11" /><TextBlock Text="{Binding RunText}" /></StackPanel>
       </Button>
      </StackPanel>
     </Grid>

     <!-- While it runs -->
     <Border Visibility="{Binding RunningVisibility}" Style="{StaticResource Card}" Padding="20">
      <StackPanel Spacing="14">
       <Grid ColumnSpacing="12">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <ProgressRing IsActive="True" Width="16" Height="16" VerticalAlignment="Center" />
        <TextBlock Grid.Column="1" Text="{Binding ProgressTitle}" Style="{StaticResource ItemTitle}" VerticalAlignment="Center" />
        <TextBlock Grid.Column="2" Text="{Binding ProgressLeft}" FontSize="12" Foreground="{ThemeResource MutedBrush}" VerticalAlignment="Center" />
       </Grid>
       <ProgressBar Minimum="0" Maximum="100" Value="{Binding Progress}" Foreground="{ThemeResource TextFillColorPrimaryBrush}" Background="{ThemeResource BadgeBrush}" />
       <TextBlock Text="{Binding ProgressDetail}" FontFamily="{StaticResource MonoFont}" FontSize="12" Foreground="{ThemeResource MutedBrush}" />
      </StackPanel>
     </Border>

     <!-- The result -->
     <StackPanel Visibility="{Binding ResultVisibility}" Spacing="12">
      <!-- A setting changed since this check -->
      <Border Visibility="{Binding NudgeVisibility}" Background="{ThemeResource InfoSoftBrush}" CornerRadius="6" Padding="14,10">
       <Grid ColumnSpacing="10">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <FontIcon Glyph="&#xE946;" FontSize="14" Foreground="{ThemeResource InfoBrush}" VerticalAlignment="Top" Margin="0,2,0,0" />
        <TextBlock Grid.Column="1" Text="{Binding Nudge}" FontSize="13" Foreground="{ThemeResource InfoBrush}" TextWrapping="Wrap" />
       </Grid>
      </Border>

      <!-- The answer, first -->
      <Border Style="{StaticResource Card}" Padding="0">
       <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="4" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <Grid>
         <Border Visibility="{Binding VerdictBetterVisibility}" Background="{ThemeResource GoodBrush}" CornerRadius="8,0,0,8" />
         <Border Visibility="{Binding VerdictWorseVisibility}" Background="{ThemeResource WarnBrush}" CornerRadius="8,0,0,8" />
         <Border Visibility="{Binding VerdictNeutralVisibility}" Background="{ThemeResource LineBrush}" CornerRadius="8,0,0,8" />
        </Grid>
        <Grid Grid.Column="1" Padding="20,14" ColumnSpacing="28">
         <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
         <StackPanel Spacing="6">
          <TextBlock Text="{Binding Headline}" FontSize="18" FontWeight="SemiBold" CharacterSpacing="-10" TextWrapping="Wrap" />
          <TextBlock Text="{Binding Subline}" Style="{StaticResource Muted}" />
          <ItemsControl Visibility="{Binding DifferencesVisibility}" ItemsSource="{Binding Differences}" ItemTemplate="{StaticResource ChipTemplate}" IsTabStop="False" Margin="0,4,0,0">
           <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="8" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
          </ItemsControl>
          <Border Visibility="{Binding SameSettingsVisibility}" Style="{StaticResource Tag}" HorizontalAlignment="Left" Margin="0,4,0,0"><TextBlock Text="Same settings both times" FontSize="12" /></Border>
         </StackPanel>
         <StackPanel Grid.Column="1" Spacing="6" MinWidth="280" VerticalAlignment="Top" Visibility="{Binding CompareVisibility}">
          <TextBlock Text="Comparing with" Style="{StaticResource ColumnLabel}" />
          <ComboBox ItemsSource="{Binding Baselines}" DisplayMemberPath="Label" SelectedItem="{Binding SelectedBaseline, Mode=OneWay}" SelectionChanged="BaselineChanged" HorizontalAlignment="Stretch" FontSize="12" AutomationProperties.Name="Which earlier check to compare with" />
         </StackPanel>
        </Grid>
       </Grid>
      </Border>

      <!-- Reasons not to trust it fully -->
      <ItemsControl Visibility="{Binding NoticesVisibility}" ItemsSource="{Binding Notices}" ItemTemplate="{StaticResource NoticeTemplate}" IsTabStop="False" />

      <!-- The four tests -->
      <ItemsRepeater ItemsSource="{Binding Metrics}" ItemTemplate="{StaticResource MetricTemplate}" AutomationProperties.Name="Check results">
       <ItemsRepeater.Layout><!-- 430 wide at least: four across on a wide window, two by two on a narrow one. A smaller minimum makes room for a fifth column that stays empty. --><UniformGridLayout x:Name="MetricsLayout" MinItemWidth="430" MinItemHeight="168" MinRowSpacing="10" MinColumnSpacing="10" ItemsStretch="Fill" /></ItemsRepeater.Layout>
      </ItemsRepeater>

      <!-- What this check was made under -->
      <StackPanel Orientation="Horizontal" Spacing="8">
       <TextBlock Text="Newest check" FontSize="12" Foreground="{ThemeResource MutedBrush}" VerticalAlignment="Center" />
       <TextBlock Text="{Binding ContextWhen}" FontSize="12" VerticalAlignment="Center" />
       <Border Style="{StaticResource Tag}"><TextBlock FontSize="11"><Run Text="Power plan " Foreground="{ThemeResource MutedBrush}" /><Run Text="{Binding ContextPlan}" /></TextBlock></Border>
       <Border Style="{StaticResource Tag}"><TextBlock FontSize="11"><Run Text="Memory integrity " Foreground="{ThemeResource MutedBrush}" /><Run Text="{Binding ContextMemory}" /></TextBlock></Border>
       <TextBlock Visibility="{Binding ContextBusyVisibility}" Text="{Binding ContextBusy}" FontSize="12" Foreground="{ThemeResource MutedBrush}" VerticalAlignment="Center" />
      </StackPanel>
     </StackPanel>

     <!-- Earlier checks -->
     <!-- Earlier checks as a table with its columns named, open by default so nothing has to be clicked to read it. -->
     <Border Visibility="{Binding HistoryVisibility}" Style="{StaticResource Card}" Padding="0">
      <StackPanel>
       <Grid Padding="8,6,16,6">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <Button Click="HistoryToggleClick" Background="Transparent" BorderThickness="0" Padding="12,6" HorizontalAlignment="Left" AutomationProperties.Name="Show or hide earlier checks">
         <StackPanel Orientation="Horizontal" Spacing="10">
          <FontIcon Glyph="{Binding HistoryChevron}" FontSize="11" Foreground="{ThemeResource MutedBrush}" />
          <TextBlock Text="{Binding HistoryTitle}" Style="{StaticResource ItemTitle}" />
         </StackPanel>
        </Button>
        <HyperlinkButton Grid.Column="1" Click="ClearHistoryClick" Padding="4,0" Content="Clear all" FontSize="12" AutomationProperties.Name="Clear earlier checks" />
       </Grid>
       <StackPanel Visibility="{Binding HistoryBodyVisibility}">
        <Grid Padding="20,8" ColumnSpacing="12" BorderBrush="{ThemeResource LineBrush}" BorderThickness="0,1,0,0">
         <Grid.ColumnDefinitions>
          <ColumnDefinition Width="150" /><ColumnDefinition Width="*" /><ColumnDefinition Width="110" />
          <ColumnDefinition Width="76" /><ColumnDefinition Width="76" /><ColumnDefinition Width="76" /><ColumnDefinition Width="76" /><ColumnDefinition Width="110" />
         </Grid.ColumnDefinitions>
         <TextBlock Text="When" Style="{StaticResource ColumnLabel}" />
         <TextBlock Grid.Column="1" Text="Power plan" Style="{StaticResource ColumnLabel}" />
         <TextBlock Grid.Column="2" Text="Memory integrity" Style="{StaticResource ColumnLabel}" TextTrimming="CharacterEllipsis" />
         <TextBlock Grid.Column="3" Text="Wake ms" Style="{StaticResource ColumnLabel}" TextAlignment="Right" ToolTipService.ToolTip="Wake-up speed, in milliseconds. Lower is better." />
         <TextBlock Grid.Column="4" Text="Work M/s" Style="{StaticResource ColumnLabel}" TextAlignment="Right" ToolTipService.ToolTip="All-core work, in million steps a second. Higher is better." />
         <TextBlock Grid.Column="5" Text="Copy GB/s" Style="{StaticResource ColumnLabel}" TextAlignment="Right" ToolTipService.ToolTip="Memory copy, in gigabytes a second. Higher is better." />
         <TextBlock Grid.Column="6" Text="Access ns" Style="{StaticResource ColumnLabel}" TextAlignment="Right" ToolTipService.ToolTip="Random memory access, in nanoseconds. Lower is better." />
        </Grid>
        <ItemsControl ItemsSource="{Binding History}" ItemTemplate="{StaticResource HistoryTemplate}" IsTabStop="False" />
       </StackPanel>
      </StackPanel>
     </Border>
    </StackPanel>

    <!-- 2. Things to try -->
    <StackPanel Spacing="12">
     <StackPanel Spacing="3">
      <TextBlock Text="Things to try" Style="{StaticResource SectionTitle}" />
      <TextBlock Text="Change one, then run the check again. Nothing here needs administrator permission, and every change can be put back." Style="{StaticResource PartNote}" />
     </StackPanel>
     <Border Style="{StaticResource Card}" Padding="0">
      <StackPanel>
       <!-- Power plan -->
       <Grid Padding="20,18" ColumnSpacing="14">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <Border Style="{StaticResource IconTile}"><FontIcon Glyph="&#xE945;" FontSize="16" Foreground="{ThemeResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
        <StackPanel Grid.Column="1" Spacing="6">
         <StackPanel Orientation="Horizontal" Spacing="10">
          <TextBlock Text="Power plan" Style="{StaticResource ItemTitle}" VerticalAlignment="Center" />
          <Border Style="{StaticResource Tag}">
           <StackPanel Orientation="Horizontal" Spacing="7">
            <Ellipse Style="{StaticResource StateDot}" Visibility="{Binding PowerFastVisibility}" Fill="{ThemeResource GoodBrush}" />
            <Ellipse Style="{StaticResource StateDot}" Visibility="{Binding PowerNormalVisibility}" Fill="{ThemeResource MutedBrush}" />
            <TextBlock Text="{Binding PowerName}" FontSize="11" />
           </StackPanel>
          </Border>
         </StackPanel>
         <TextBlock Text="{Binding PowerText}" Style="{StaticResource PartNote}" />
         <TextBlock Visibility="{Binding PowerWarningVisibility}" Text="{Binding PowerWarning}" FontSize="12" Foreground="{ThemeResource WarnBrush}" TextWrapping="Wrap" />
        </StackPanel>
        <Button Grid.Column="2" Click="PowerClick" IsEnabled="{Binding PowerCanClick}" Padding="14,7" MinWidth="170" VerticalAlignment="Top" AutomationProperties.Name="Change the power plan">
         <TextBlock Text="{Binding PowerButton}" FontSize="12" HorizontalAlignment="Center" />
        </Button>
       </Grid>

       <Border Height="1" Background="{ThemeResource LineBrush}" />

       <!-- Memory integrity: shown here because it matters for speed, changed in Tune where it can be undone -->
       <Grid Padding="20,18" ColumnSpacing="14">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <Border Style="{StaticResource IconTile}"><FontIcon Glyph="&#xEA18;" FontSize="16" Foreground="{ThemeResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
        <StackPanel Grid.Column="1" Spacing="6">
         <StackPanel Orientation="Horizontal" Spacing="10">
          <TextBlock Text="Memory integrity" Style="{StaticResource ItemTitle}" VerticalAlignment="Center" />
          <Border Style="{StaticResource Tag}">
           <StackPanel Orientation="Horizontal" Spacing="7">
            <Ellipse Style="{StaticResource StateDot}" Visibility="{Binding MemoryOnVisibility}" Fill="{ThemeResource GoodBrush}" />
            <Ellipse Style="{StaticResource StateDot}" Visibility="{Binding MemoryOffVisibility}" Fill="{ThemeResource WarnBrush}" />
            <TextBlock Text="{Binding MemoryIntegrityState}" FontSize="11" />
           </StackPanel>
          </Border>
         </StackPanel>
         <TextBlock Text="{Binding MemoryIntegrityText}" Style="{StaticResource PartNote}" />
        </StackPanel>
        <Button Grid.Column="2" Click="TuneClick" Padding="14,7" MinWidth="170" VerticalAlignment="Top" AutomationProperties.Name="Open Tune to change memory integrity">
         <TextBlock Text="Open in Tune" FontSize="12" HorizontalAlignment="Center" />
        </Button>
       </Grid>
      </StackPanel>
     </Border>
    </StackPanel>

    <!-- 3. App priority -->
    <StackPanel Spacing="12">
     <Grid ColumnSpacing="14">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <StackPanel Spacing="3" VerticalAlignment="Center">
       <StackPanel Orientation="Horizontal" Spacing="10">
        <TextBlock Text="App priority" Style="{StaticResource SectionTitle}" />
        <TextBlock Text="{Binding AppsCount}" FontSize="12" Foreground="{ThemeResource MutedBrush}" VerticalAlignment="Center" />
       </StackPanel>
       <TextBlock Text="{Binding AppsNote}" Style="{StaticResource PartNote}" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
       <Button Click="PutBackClick" Visibility="{Binding PutBackVisibility}" Padding="12,7" FontSize="12" Content="Put all back" AutomationProperties.Name="Put every changed app back" />
       <Button Click="RefreshClick" Padding="12,7" AutomationProperties.Name="Refresh the list of apps" ToolTipService.ToolTip="Refresh the list"><FontIcon Glyph="&#xE72C;" FontSize="12" /></Button>
      </StackPanel>
     </Grid>
     <Border Style="{StaticResource Card}" Padding="0">
      <ItemsControl ItemsSource="{Binding Apps}" ItemTemplate="{StaticResource AppTemplate}" IsTabStop="False" AutomationProperties.Name="Running apps" />
     </Border>
    </StackPanel>

    <Grid ColumnSpacing="10" Margin="2,0,2,0">
     <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
     <FontIcon Glyph="&#xE946;" FontSize="13" Foreground="{ThemeResource MutedBrush}" VerticalAlignment="Top" Margin="0,2,0,0" />
     <TextBlock Grid.Column="1" Text="Only things with evidence behind them are here. Boot timer tweaks, pagefile presets, turning services off and pinning programs to certain cores are left out on purpose: they do not help, or help less than they cost. Nothing on this page changes the registry or needs administrator permission." Style="{StaticResource PartNote}" />
    </Grid>
   </StackPanel>
  </ScrollViewer>
 </Grid>
</UserControl>
