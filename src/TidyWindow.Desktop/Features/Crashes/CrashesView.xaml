<UserControl x:Class="TidyWindow.Next.Desktop.CrashesView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="using:TidyWindow.Next.Desktop"
 HorizontalContentAlignment="Stretch">
 <UserControl.Resources>
  <ResourceDictionary>
   <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="ms-appx:///Styles/ListStyles.xaml" /></ResourceDictionary.MergedDictionaries>

   <!-- One label and value in an opened event -->
   <DataTemplate x:Key="FactTemplate">
    <Grid ColumnSpacing="14" Margin="0,0,0,6">
     <Grid.ColumnDefinitions><ColumnDefinition Width="92" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
     <TextBlock Text="{Binding Label}" FontSize="12" Foreground="{ThemeResource MutedBrush}" />
     <TextBlock Grid.Column="1" Text="{Binding Value}" Visibility="{Binding PlainVisibility}" FontSize="12" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
     <TextBlock Grid.Column="1" Text="{Binding Value}" Visibility="{Binding MonoVisibility}" FontFamily="{StaticResource MonoFont}" FontSize="11" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
    </Grid>
   </DataTemplate>

   <!-- One crash, freeze or Windows problem. The line says what happened and when; the details open underneath. -->
   <DataTemplate x:Key="EventRowTemplate">
    <Border BorderBrush="{ThemeResource LineBrush}" BorderThickness="0,0,0,1">
     <StackPanel>
      <Grid Padding="16,10" MinHeight="52" ColumnSpacing="12" Background="Transparent" Tapped="EventTapped">
       <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
       </Grid.ColumnDefinitions>
       <Ellipse Width="8" Height="8" Fill="{Binding DotBrush}" VerticalAlignment="Center" />
       <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
        <TextBlock Text="{Binding Headline}" Style="{StaticResource ItemTitle}" TextWrapping="Wrap" MaxLines="2" local:TrimTip.Enabled="True" />
        <TextBlock Text="{Binding Sub}" Style="{StaticResource RowSub}" local:TrimTip.Enabled="True" />
       </StackPanel>
       <Border Grid.Column="2" Visibility="{Binding RepeatsVisibility}" Background="{ThemeResource BadgeBrush}" CornerRadius="10" Padding="8,2" VerticalAlignment="Center" ToolTipService.ToolTip="Happened this many times within a few minutes of each other"><TextBlock Text="{Binding Repeats}" FontSize="11" Foreground="{ThemeResource MutedBrush}" /></Border>
       <Button Grid.Column="3" Click="EventDetailsClick" Padding="8" Background="Transparent" BorderThickness="0" VerticalAlignment="Center" AutomationProperties.Name="{Binding DetailsName}" ToolTipService.ToolTip="Details">
        <FontIcon Glyph="{Binding Chevron}" FontSize="12" Foreground="{ThemeResource MutedBrush}" />
       </Button>
      </Grid>
      <StackPanel Visibility="{Binding DetailsVisibility}" Margin="36,0,16,14" Spacing="10">
       <TextBlock Text="{Binding Explanation}" Visibility="{Binding ExplanationVisibility}" Style="{StaticResource Muted}" FontSize="12" IsTextSelectionEnabled="True" />
       <ItemsControl ItemsSource="{Binding Facts}" ItemTemplate="{StaticResource FactTemplate}" IsTabStop="False" />
       <ItemsControl ItemsSource="{Binding TechnicalFacts}" ItemTemplate="{StaticResource FactTemplate}" Visibility="{Binding TechnicalVisibility}" IsTabStop="False" />
       <StackPanel Orientation="Horizontal" Spacing="16">
        <HyperlinkButton Click="CopyEventClick" Padding="0" FontSize="12" AutomationProperties.Name="Copy details" ToolTipService.ToolTip="Copy these details, with your Windows account name hidden, to paste into a support request">
         <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="{Binding CopyGlyph}" FontSize="11" /><TextBlock Text="Copy details" /></StackPanel>
        </HyperlinkButton>
        <HyperlinkButton Click="SearchWebClick" Padding="0" Content="Search the web" FontSize="12" AutomationProperties.Name="Search the web for this problem" ToolTipService.ToolTip="Opens a web search for this error in your browser" />
        <HyperlinkButton Click="OpenReportClick" Visibility="{Binding ReportVisibility}" Padding="0" Content="Windows report" FontSize="12" AutomationProperties.Name="Open Windows report folder" ToolTipService.ToolTip="The report Windows saved for this problem, if it still keeps it" />
        <HyperlinkButton Click="ShowProgramClick" Visibility="{Binding ProgramVisibility}" Padding="0" Content="Show program" FontSize="12" AutomationProperties.Name="Show the program in its folder" />
        <HyperlinkButton Click="TechnicalClick" Padding="0" Content="{Binding TechnicalLabel}" FontSize="12" Foreground="{ThemeResource MutedBrush}" />
       </StackPanel>
      </StackPanel>
     </StackPanel>
    </Border>
   </DataTemplate>

   <!-- One program, with how much trouble it has caused and when. Opening it lists what failed and the events behind the count. -->
   <DataTemplate x:Key="AppRowTemplate">
    <Border BorderBrush="{ThemeResource LineBrush}" BorderThickness="0,0,0,1">
     <StackPanel>
      <Grid Padding="16,12" MinHeight="68" ColumnSpacing="14" Background="Transparent" Tapped="AppTapped">
       <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
       </Grid.ColumnDefinitions>
       <local:AppIcon Source="{Binding Icon}" />
       <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
        <TextBlock Text="{Binding Name}" Style="{StaticResource RowTitle}" local:TrimTip.Enabled="True" />
        <TextBlock Text="{Binding Sub}" Style="{StaticResource RowSub}" local:TrimTip.Enabled="True" />
        <ProgressBar Value="{Binding Bar}" Minimum="0" Maximum="1" Height="3" MinHeight="3" Margin="0,5,0,0" CornerRadius="2" Foreground="{ThemeResource WarnBrush}" Background="{ThemeResource BadgeBrush}" IsTabStop="False" AutomationProperties.AccessibilityView="Raw" />
       </StackPanel>
       <ItemsControl Grid.Column="2" ItemsSource="{Binding Days}" VerticalAlignment="Center" Height="26" IsTabStop="False" ToolTipService.ToolTip="Problems per day, oldest to newest" AutomationProperties.AccessibilityView="Raw">
        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Bottom" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
         <DataTemplate><Border Width="4" Height="{Binding Height}" Opacity="{Binding Opacity}" VerticalAlignment="Bottom" CornerRadius="1" Background="{ThemeResource MutedBrush}" ToolTipService.ToolTip="{Binding Tip}" /></DataTemplate>
        </ItemsControl.ItemTemplate>
       </ItemsControl>
       <Border Grid.Column="3" Background="{ThemeResource BadgeBrush}" CornerRadius="10" Padding="10,3" VerticalAlignment="Center" MinWidth="36" ToolTipService.ToolTip="Crashes and times it stopped responding"><TextBlock Text="{Binding Count}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" /></Border>
       <Button Grid.Column="4" Click="AppDetailsClick" Padding="8" Background="Transparent" BorderThickness="0" VerticalAlignment="Center" AutomationProperties.Name="{Binding DetailsName}" ToolTipService.ToolTip="Details">
        <FontIcon Glyph="{Binding Chevron}" FontSize="12" Foreground="{ThemeResource MutedBrush}" />
       </Button>
      </Grid>

      <Border Visibility="{Binding DetailsVisibility}" Margin="66,0,16,14" Padding="0,2,0,0">
       <StackPanel Spacing="10">
        <StackPanel Visibility="{Binding SignaturesVisibility}" Spacing="6">
         <TextBlock Text="What failed" Style="{StaticResource GroupLabel}" />
         <ItemsControl ItemsSource="{Binding Signatures}" IsTabStop="False">
          <ItemsControl.ItemTemplate>
           <DataTemplate>
            <Grid ColumnSpacing="12" Margin="0,0,0,4">
             <Grid.ColumnDefinitions><ColumnDefinition Width="40" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
             <TextBlock Text="{Binding Count}" FontSize="12" FontWeight="SemiBold" />
             <TextBlock Grid.Column="1" Text="{Binding Label}" FontSize="12" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
            </Grid>
           </DataTemplate>
          </ItemsControl.ItemTemplate>
         </ItemsControl>
        </StackPanel>
        <TextBlock Text="{Binding Versions}" Visibility="{Binding VersionsVisibility}" Style="{StaticResource Muted}" FontSize="12" IsTextSelectionEnabled="True" />
        <TextBlock Text="{Binding Path}" Visibility="{Binding PathVisibility}" FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="{ThemeResource MutedBrush}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
        <StackPanel Orientation="Horizontal" Spacing="16">
         <HyperlinkButton Click="CopyAppClick" Padding="0" Content="Copy summary" FontSize="12" AutomationProperties.Name="Copy a summary of this program" ToolTipService.ToolTip="Copy a summary and the latest events, with your Windows account name hidden" />
         <HyperlinkButton Click="ShowAppFolderClick" Visibility="{Binding PathVisibility}" Padding="0" Content="Show in folder" FontSize="12" AutomationProperties.Name="Show the program in its folder" />
        </StackPanel>
        <TextBlock Text="What happened" Style="{StaticResource GroupLabel}" Margin="0,6,0,0" />
        <Border BorderBrush="{ThemeResource LineBrush}" BorderThickness="0,1,0,0" Margin="-16,0,-16,0">
         <ItemsControl ItemsSource="{Binding Events}" ItemTemplate="{StaticResource EventRowTemplate}" IsTabStop="False" />
        </Border>
        <HyperlinkButton Click="ShowAllClick" Visibility="{Binding MoreVisibility}" Padding="0" Content="{Binding MoreText}" FontSize="12" HorizontalAlignment="Left" />
       </StackPanel>
      </Border>
     </StackPanel>
    </Border>
   </DataTemplate>

   <DataTemplate x:Key="InsightTemplate">
    <Border Style="{StaticResource Card}" Background="{ThemeResource InfoSoftBrush}" Padding="14,12" Margin="0,0,0,8">
     <Grid ColumnSpacing="12">
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <FontIcon Glyph="&#xE946;" FontSize="16" Foreground="{ThemeResource InfoBrush}" VerticalAlignment="Top" Margin="0,2,0,0" />
      <StackPanel Grid.Column="1" Spacing="3">
       <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="Medium" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
       <TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}" FontSize="12" IsTextSelectionEnabled="True" />
      </StackPanel>
      <Button Grid.Column="2" Click="DismissInsightClick" Padding="6" MinWidth="0" MinHeight="0" VerticalAlignment="Top" Margin="0,-4,-6,0" Background="Transparent" BorderThickness="0"
              AutomationProperties.Name="Dismiss this observation" ToolTipService.ToolTip="Dismiss. It comes back only if the situation changes.">
       <FontIcon Glyph="&#xE711;" FontSize="11" />
      </Button>
     </Grid>
    </Border>
   </DataTemplate>
  </ResourceDictionary>
 </UserControl.Resources>

 <Grid RowSpacing="14">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" />
  </Grid.RowDefinitions>

  <!-- Title -->
  <Grid ColumnSpacing="12">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
   <StackPanel Spacing="4" VerticalAlignment="Center">
    <TextBlock Text="Crashes" Style="{StaticResource PageTitle}" />
    <TextBlock Text="Apps that crashed or froze, and problems Windows hit, read from Windows’ own records. Nothing runs in the background." Style="{StaticResource Muted}" />
   </StackPanel>
   <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
    <TextBlock Text="{Binding Status}" Style="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" MaxWidth="260" />
    <Button Click="RefreshClick" IsEnabled="{Binding CanScan}" Padding="12,7" AutomationProperties.Name="Check again" ToolTipService.ToolTip="Read anything new from Windows">
     <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE72C;" FontSize="12" /><TextBlock Text="{Binding ScanLabel}" FontSize="12" /></StackPanel>
    </Button>
    <Button Click="CopyClick" Padding="12,7" AutomationProperties.Name="Copy report" ToolTipService.ToolTip="Copy what is shown as text, with your Windows account name hidden">
     <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon x:Name="CopyIcon" Glyph="&#xE8C8;" FontSize="12" /><TextBlock x:Name="CopyLabel" Text="Copy" FontSize="12" /></StackPanel>
    </Button>
    <Button Padding="10,7" AutomationProperties.Name="More options">
     <FontIcon Glyph="&#xE712;" FontSize="12" />
     <Button.Flyout>
      <MenuFlyout>
       <MenuFlyoutItem Text="Read the last 90 days again" Click="ReadAgainClick"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE72C;" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
       <MenuFlyoutItem Text="Open Event Viewer" Click="EventViewerClick"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8A7;" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
       <MenuFlyoutSeparator />
       <MenuFlyoutItem Text="Clear saved history…" Click="ClearClick"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74D;" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
      </MenuFlyout>
     </Button.Flyout>
    </Button>
   </StackPanel>
  </Grid>

  <!-- Warnings: a log Windows would not let us read, or history that cannot be saved -->
  <StackPanel Grid.Row="1" Spacing="8">
   <Border Style="{StaticResource Card}" Background="{ThemeResource WarnSoftBrush}" Padding="14,10" Visibility="{Binding ProblemVisibility}">
    <Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
     <FontIcon Glyph="&#xE7BA;" FontSize="14" Foreground="{ThemeResource WarnBrush}" VerticalAlignment="Top" Margin="0,2,0,0" />
     <TextBlock Grid.Column="1" Text="{Binding Problem}" FontSize="12" TextWrapping="Wrap" IsTextSelectionEnabled="True" /></Grid>
   </Border>
   <Border Style="{StaticResource Card}" Background="{ThemeResource WarnSoftBrush}" Padding="14,10" Visibility="{Binding StorageWarningVisibility}">
    <TextBlock Text="{Binding StorageWarning}" FontSize="12" TextWrapping="Wrap" />
   </Border>
  </StackPanel>

  <!-- What the whole list shows that no single row does -->
  <ItemsControl Grid.Row="2" ItemsSource="{Binding Insights}" ItemTemplate="{StaticResource InsightTemplate}" Visibility="{Binding InsightsVisibility}" IsTabStop="False" Margin="0,0,0,-6" />

  <!-- Three views of the same records -->
  <Grid Grid.Row="3" BorderBrush="{ThemeResource LineBrush}" BorderThickness="0,0,0,1" Margin="0,-4,0,0">
   <StackPanel Orientation="Horizontal">
    <RadioButton GroupName="CrashTabs" Tag="Apps" IsChecked="True" Checked="TabChecked" Style="{StaticResource StatTabStyle}" AutomationProperties.Name="By app" ToolTipService.ToolTip="Which programs crash or freeze the most">
     <StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="By app" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" /><Border Background="{ThemeResource BadgeBrush}" CornerRadius="10" Padding="7,1" VerticalAlignment="Center"><TextBlock Text="{Binding AppsTab}" FontSize="11" /></Border></StackPanel>
    </RadioButton>
    <RadioButton GroupName="CrashTabs" Tag="Windows" Checked="TabChecked" Style="{StaticResource StatTabStyle}" AutomationProperties.Name="Windows" ToolTipService.ToolTip="Blue screens, unexpected shutdowns, failing services, drivers, disks and hardware">
     <StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="Windows" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" /><Border Background="{ThemeResource BadgeBrush}" CornerRadius="10" Padding="7,1" VerticalAlignment="Center"><TextBlock Text="{Binding WindowsTab}" FontSize="11" /></Border></StackPanel>
    </RadioButton>
    <RadioButton GroupName="CrashTabs" Tag="Timeline" Checked="TabChecked" Style="{StaticResource StatTabStyle}" AutomationProperties.Name="Timeline" ToolTipService.ToolTip="Everything, newest first">
     <StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="Timeline" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" /><Border Background="{ThemeResource BadgeBrush}" CornerRadius="10" Padding="7,1" VerticalAlignment="Center"><TextBlock Text="{Binding TimelineTab}" FontSize="11" /></Border></StackPanel>
    </RadioButton>
   </StackPanel>
  </Grid>

  <!-- Search, time range, kind and order -->
  <StackPanel Grid.Row="4" Spacing="8">
   <Grid ColumnSpacing="10">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*" MaxWidth="560" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
    <TextBox x:Name="SearchBox" PlaceholderText="Search: an app, an error, or app:chrome kind:hang since:7d" MaxLength="200" TextChanged="QueryChanged" AutomationProperties.Name="Search crashes" VerticalAlignment="Center" />
    <Button Grid.Column="1" Padding="9,7" VerticalAlignment="Center" AutomationProperties.Name="Search help" ToolTipService.ToolTip="How to search">
     <FontIcon Glyph="&#xE897;" FontSize="12" />
     <Button.Flyout>
      <Flyout>
       <StackPanel Spacing="6" MaxWidth="380">
        <TextBlock Text="Searching" Style="{StaticResource SectionTitle}" FontSize="14" />
        <TextBlock Text="Type any words: each one must appear somewhere in the event. Small typos are forgiven." Style="{StaticResource Muted}" FontSize="12" />
        <TextBlock FontFamily="{StaticResource MonoFont}" FontSize="11" TextWrapping="Wrap" IsTextSelectionEnabled="True" Text="chrome freeze&#x0A;&quot;access violation&quot;&#x0A;-edge            leave out edge&#x0A;app:chrome         module:nvlddmkm&#x0A;code:c0000005      version:130&#x0A;kind:hang         kind:crash   kind:bsod&#x0A;kind:windows       kind:service&#x0A;source:&quot;Application Error&quot;&#x0A;since:7d  since:yesterday  since:2026-10-01&#x0A;before:2d" />
        <TextBlock Text="Several values for one field (app:chrome app:edge) mean either. Plain words like freeze, bsod or driver find matching kinds." Style="{StaticResource Muted}" FontSize="12" />
       </StackPanel>
      </Flyout>
     </Button.Flyout>
    </Button>
    <Border Grid.Column="3" BorderBrush="{ThemeResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="3" VerticalAlignment="Center">
     <StackPanel Orientation="Horizontal" Spacing="2">
      <RadioButton GroupName="CrashRange" Tag="Day" Checked="RangeChecked" Content="24 h" Style="{StaticResource SegmentStyle}" />
      <RadioButton GroupName="CrashRange" Tag="Week" Checked="RangeChecked" Content="7 days" Style="{StaticResource SegmentStyle}" />
      <RadioButton GroupName="CrashRange" Tag="Month" IsChecked="True" Checked="RangeChecked" Content="30 days" Style="{StaticResource SegmentStyle}" />
      <RadioButton GroupName="CrashRange" Tag="Quarter" Checked="RangeChecked" Content="90 days" Style="{StaticResource SegmentStyle}" />
     </StackPanel>
    </Border>
   </Grid>
   <Grid ColumnSpacing="12">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
    <TextBlock Text="{Binding Understood}" Visibility="{Binding UnderstoodVisibility}" Style="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
    <Border Grid.Column="1" Visibility="{Binding FilterVisibility}" BorderBrush="{ThemeResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="3" VerticalAlignment="Center">
     <StackPanel Orientation="Horizontal" Spacing="2">
      <RadioButton GroupName="CrashFilter" Tag="All" IsChecked="True" Checked="FilterChecked" Content="All" Style="{StaticResource SegmentStyle}" />
      <RadioButton GroupName="CrashFilter" Tag="Crashes" Checked="FilterChecked" Content="Crashes" Style="{StaticResource SegmentStyle}" ToolTipService.ToolTip="Only programs that closed unexpectedly" />
      <RadioButton GroupName="CrashFilter" Tag="Hangs" Checked="FilterChecked" Content="Not responding" Style="{StaticResource SegmentStyle}" ToolTipService.ToolTip="Only programs that froze" />
     </StackPanel>
    </Border>
    <Border Grid.Column="2" Visibility="{Binding SortVisibility}" BorderBrush="{ThemeResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="3" VerticalAlignment="Center">
     <StackPanel Orientation="Horizontal" Spacing="2">
      <RadioButton GroupName="CrashSort" Tag="Most" IsChecked="True" Checked="SortChecked" Content="Most" Style="{StaticResource SegmentStyle}" ToolTipService.ToolTip="Most problems first" />
      <RadioButton GroupName="CrashSort" Tag="Recent" Checked="SortChecked" Content="Recent" Style="{StaticResource SegmentStyle}" ToolTipService.ToolTip="Most recent first" />
      <RadioButton GroupName="CrashSort" Tag="Name" Checked="SortChecked" Content="A–Z" Style="{StaticResource SegmentStyle}" />
     </StackPanel>
    </Border>
   </Grid>
  </StackPanel>

  <!-- The lists -->
  <Grid Grid.Row="5">
   <Border Style="{StaticResource Card}" Padding="0" Margin="0,0,0,12" VerticalAlignment="Top" Visibility="{Binding AppsVisibility}">
    <ListView ItemsSource="{Binding Apps}" ItemTemplate="{StaticResource AppRowTemplate}" ItemContainerStyle="{StaticResource RowContainer}" SelectionMode="None" IsItemClickEnabled="False" HorizontalContentAlignment="Stretch" Margin="0,0,0,-1" AutomationProperties.Name="Apps that crashed or froze" />
   </Border>
   <Border Style="{StaticResource Card}" Padding="0" Margin="0,0,0,12" VerticalAlignment="Top" Visibility="{Binding WindowsVisibility}">
    <ListView ItemsSource="{Binding WindowsEvents}" ItemTemplate="{StaticResource EventRowTemplate}" ItemContainerStyle="{StaticResource RowContainer}" SelectionMode="None" IsItemClickEnabled="False" HorizontalContentAlignment="Stretch" Margin="0,0,0,-1" AutomationProperties.Name="Windows problems" />
   </Border>
   <Border Style="{StaticResource Card}" Padding="0" Margin="0,0,0,12" VerticalAlignment="Top" Visibility="{Binding TimelineVisibility}">
    <ListView ItemsSource="{Binding Timeline}" ItemTemplate="{StaticResource EventRowTemplate}" ItemContainerStyle="{StaticResource RowContainer}" SelectionMode="None" IsItemClickEnabled="False" HorizontalContentAlignment="Stretch" Margin="0,0,0,-1" AutomationProperties.Name="Everything, newest first" />
   </Border>
   <TextBlock Text="{Binding MoreRowsNote}" Visibility="{Binding MoreRowsVisibility}" Style="{StaticResource Muted}" FontSize="12" VerticalAlignment="Bottom" HorizontalAlignment="Center" />

   <StackPanel Visibility="{Binding EmptyVisibility}" HorizontalAlignment="Center" VerticalAlignment="Top" Padding="24,56" Spacing="10">
    <Border Width="44" Height="44" CornerRadius="10" BorderThickness="1" BorderBrush="{ThemeResource LineBrush}" Background="{ThemeResource CanvasBrush}" HorizontalAlignment="Center">
     <FontIcon Glyph="{Binding EmptyGlyph}" FontSize="18" Foreground="{ThemeResource MutedBrush}" />
    </Border>
    <TextBlock Text="{Binding EmptyTitle}" Style="{StaticResource EmptyTitle}" />
    <TextBlock Text="{Binding EmptyText}" Style="{StaticResource Muted}" TextAlignment="Center" MaxWidth="400" />
   </StackPanel>
   <local:LoadingOverlay IsActive="{Binding Overlay}" Text="{Binding OverlayText}" />
  </Grid>
 </Grid>
</UserControl>
