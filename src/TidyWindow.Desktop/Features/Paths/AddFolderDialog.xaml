<ContentDialog x:Class="TidyWindow.Next.Desktop.AddFolderDialog"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="using:TidyWindow.Next.Desktop"
 Title="Add a folder to PATH" PrimaryButtonText="Add to PATH" CloseButtonText="Cancel" DefaultButton="Primary"
 IsPrimaryButtonEnabled="{Binding CanAdd}" PrimaryButtonClick="PrimaryClick">
 <ContentDialog.Resources>
  <x:Double x:Key="ContentDialogMaxWidth">760</x:Double>
  <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas</FontFamily>
 </ContentDialog.Resources>

 <Grid Width="660" RowSpacing="14">
  <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="320" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>

  <TextBlock Text="Pick a folder that holds the programs you want to run by name. TidyWindow looks through the places programs usually live, so you do not have to know the path." Style="{StaticResource Muted}" />

  <TextBox Grid.Row="1" PlaceholderText="Search by program or folder, e.g. ffmpeg, cargo, or paste a path" TextChanged="QueryChanged" AutomationProperties.Name="Search for a folder" />

  <Grid Grid.Row="2" ColumnSpacing="10">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
   <StackPanel Spacing="2">
    <TextBlock Text="{Binding Heading}" Style="{StaticResource ItemTitle}" />
    <TextBlock Text="{Binding Hint}" Visibility="{Binding HintVisibility}" Style="{StaticResource Muted}" FontSize="12" />
   </StackPanel>
   <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" Visibility="{Binding ScanVisibility}" VerticalAlignment="Center">
    <ProgressRing IsActive="True" Width="16" Height="16" />
    <TextBlock Text="Looking through your programs…" Style="{StaticResource Muted}" FontSize="12" />
   </StackPanel>
  </Grid>

  <Border Grid.Row="3" Background="{ThemeResource CanvasBrush}" BorderBrush="{ThemeResource LineBrush}" BorderThickness="1" CornerRadius="8">
   <Grid>
    <ListView ItemsSource="{Binding Results}" SelectedItem="{Binding Selected, Mode=TwoWay}" SelectionMode="Single" DoubleTapped="ResultDoubleTapped" AutomationProperties.Name="Folders you can add">
     <ListView.ItemTemplate><DataTemplate x:DataType="local:FolderResult">
      <Grid ColumnSpacing="12" Padding="4,8">
       <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
       <FontIcon Glyph="&#xE8B7;" FontSize="16" Foreground="{ThemeResource MutedBrush}" VerticalAlignment="Top" Margin="0,2,0,0" />
       <StackPanel Grid.Column="1" Spacing="3">
        <TextBlock Text="{x:Bind Folder}" FontFamily="{StaticResource MonoFont}" FontSize="12" TextTrimming="CharacterEllipsis" local:TrimTip.Enabled="True" />
        <TextBlock Text="{x:Bind ProgramsText}" FontSize="12" Foreground="{ThemeResource MutedBrush}" TextTrimming="CharacterEllipsis" />
       </StackPanel>
      </Grid>
     </DataTemplate></ListView.ItemTemplate>
    </ListView>
    <TextBlock Text="{Binding EmptyText}" Visibility="{Binding EmptyVisibility}" Style="{StaticResource Muted}" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="440" />
   </Grid>
  </Border>

  <Border Grid.Row="4" Background="{ThemeResource PanelBrush}" BorderBrush="{ThemeResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="16,10">
   <Grid ColumnSpacing="12">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
    <TextBlock Text="Cannot find it? Pick the folder yourself in File Explorer." Style="{StaticResource Muted}" VerticalAlignment="Center" />
    <Button Grid.Column="1" Click="BrowseClick" Padding="14,6">
     <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE838;" FontSize="12" /><TextBlock Text="Browse…" FontSize="13" /></StackPanel>
    </Button>
   </Grid>
  </Border>
 </Grid>
</ContentDialog>
