<UserControl x:Class="TidyWindow.Next.Desktop.DebloatView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="using:TidyWindow.Next.Desktop"
 HorizontalContentAlignment="Stretch">
 <UserControl.Resources>
  <ResourceDictionary>
   <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="ms-appx:///Styles/ListStyles.xaml" /></ResourceDictionary.MergedDictionaries>

   <!-- One row for each thing that can be removed. The line says what it is and has the tick; the small print opens underneath. -->
   <DataTemplate x:Key="DebloatRowTemplate">
    <Border BorderBrush="{ThemeResource LineBrush}" BorderThickness="0,0,0,1">
     <StackPanel>
      <Grid Padding="16,12" MinHeight="64" ColumnSpacing="14" Background="Transparent" Tapped="RowTapped">
       <Grid.ColumnDefinitions>
        <ColumnDefinition Width="28" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
       </Grid.ColumnDefinitions>

       <Grid VerticalAlignment="Center">
        <CheckBox IsChecked="{Binding Selected, Mode=TwoWay}" IsEnabled="{Binding CanSelect}" Visibility="{Binding CheckVisibility}" MinWidth="0" Padding="0" AutomationProperties.Name="{Binding AutomationName}" />
        <FontIcon Glyph="&#xE72E;" FontSize="14" Visibility="{Binding LockVisibility}" Foreground="{ThemeResource MutedBrush}" HorizontalAlignment="Center" ToolTipService.ToolTip="This cannot be removed right now" />
       </Grid>

       <Border Grid.Column="1" Width="36" Height="36" CornerRadius="8" BorderThickness="1" BorderBrush="{ThemeResource LineBrush}" Background="{ThemeResource CanvasBrush}" VerticalAlignment="Center">
        <FontIcon Glyph="{Binding Glyph}" FontSize="16" Foreground="{ThemeResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
       </Border>

       <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center">
        <TextBlock Text="{Binding Name}" Style="{StaticResource RowTitle}" local:TrimTip.Enabled="True" />
        <TextBlock Text="{Binding Sub}" Style="{StaticResource RowSub}" local:TrimTip.Enabled="True" />
        <TextBlock Text="{Binding Note}" Visibility="{Binding NoteVisibility}" FontSize="12" Foreground="{ThemeResource WarnBrush}" TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
       </StackPanel>

       <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <Border Visibility="{Binding SuggestedVisibility}" Background="{ThemeResource BadgeBrush}" CornerRadius="10" Padding="8,2" VerticalAlignment="Center" ToolTipService.ToolTip="Almost nobody uses this. It is ticked by Select suggested."><TextBlock Text="Suggested" FontSize="11" Foreground="{ThemeResource MutedBrush}" /></Border>
        <Border Visibility="{Binding CarefulVisibility}" Background="{ThemeResource WarnSoftBrush}" CornerRadius="10" Padding="8,2" VerticalAlignment="Center" ToolTipService.ToolTip="This has a trade-off. You will be told what it is before anything is removed."><TextBlock Text="Careful" FontSize="11" Foreground="{ThemeResource WarnBrush}" /></Border>
       </StackPanel>

       <Button Grid.Column="4" Click="DetailsClick" Padding="8" Background="Transparent" BorderThickness="0" VerticalAlignment="Center" AutomationProperties.Name="{Binding DetailsName}" ToolTipService.ToolTip="Details">
        <FontIcon Glyph="{Binding Chevron}" FontSize="12" Foreground="{ThemeResource MutedBrush}" />
       </Button>
      </Grid>

      <!-- Opened with the arrow or by clicking the row. -->
      <Border Visibility="{Binding DetailsVisibility}" Margin="94,0,16,14" Padding="14,12,14,4" CornerRadius="8" BorderThickness="1" BorderBrush="{ThemeResource LineBrush}" Background="{ThemeResource CanvasBrush}">
       <ItemsControl ItemsSource="{Binding Facts}" IsTabStop="False">
        <ItemsControl.ItemTemplate>
         <DataTemplate>
          <Grid ColumnSpacing="14" Margin="0,0,0,8">
           <Grid.ColumnDefinitions><ColumnDefinition Width="120" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
           <TextBlock Text="{Binding Label}" FontSize="12" Foreground="{ThemeResource MutedBrush}" />
           <TextBlock Grid.Column="1" Text="{Binding Value}" Visibility="{Binding PlainVisibility}" FontSize="12" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
           <TextBlock Grid.Column="1" Text="{Binding Value}" Visibility="{Binding MonoVisibility}" FontFamily="{StaticResource MonoFont}" FontSize="11" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
          </Grid>
         </DataTemplate>
        </ItemsControl.ItemTemplate>
       </ItemsControl>
      </Border>
     </StackPanel>
    </Border>
   </DataTemplate>
  </ResourceDictionary>
 </UserControl.Resources>

 <Grid RowSpacing="16">
  <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>

  <!-- Title -->
  <Grid ColumnSpacing="12">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
   <StackPanel Spacing="4" VerticalAlignment="Center">
    <TextBlock Text="Debloat" Style="{StaticResource PageTitle}" />
    <TextBlock Text="Remove the apps Windows and your PC's maker install, for every account, so they stay removed. Everything can be put back." Style="{StaticResource Muted}" />
   </StackPanel>
   <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
    <TextBlock Text="{Binding CheckedText}" Style="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center" TextWrapping="NoWrap" />
    <Button Click="ScanClick" IsEnabled="{Binding CanScan}" Padding="12,7" VerticalAlignment="Center" AutomationProperties.Name="Check again">
     <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE72C;" FontSize="12" /><TextBlock Text="{Binding ScanLabel}" FontSize="12" /></StackPanel>
    </Button>
   </StackPanel>
  </Grid>

  <!-- Five groups and the list of removed items as slim tabs, each with its count -->
  <Grid Grid.Row="1" BorderBrush="{ThemeResource LineBrush}" BorderThickness="0,0,0,1" Margin="0,-4,0,0">
   <StackPanel Orientation="Horizontal">
    <RadioButton GroupName="DebloatTabs" Tag="Microsoft" IsChecked="True" Checked="TabChecked" Style="{StaticResource StatTabStyle}" AutomationProperties.Name="Microsoft apps" ToolTipService.ToolTip="Apps Microsoft installs for you">
     <StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="Microsoft" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" /><Border Background="{ThemeResource BadgeBrush}" CornerRadius="10" Padding="7,1" VerticalAlignment="Center"><TextBlock Text="{Binding MicrosoftCount}" FontSize="11" /></Border></StackPanel>
    </RadioButton>
    <RadioButton GroupName="DebloatTabs" Tag="Promoted" Checked="TabChecked" Style="{StaticResource StatTabStyle}" AutomationProperties.Name="Promoted apps" ToolTipService.ToolTip="Games and apps installed as advertising">
     <StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="Promoted" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" /><Border Background="{ThemeResource BadgeBrush}" CornerRadius="10" Padding="7,1" VerticalAlignment="Center"><TextBlock Text="{Binding PromotedCount}" FontSize="11" /></Border></StackPanel>
    </RadioButton>
    <RadioButton GroupName="DebloatTabs" Tag="Ai" Checked="TabChecked" Style="{StaticResource StatTabStyle}" AutomationProperties.Name="Copilot and Recall" ToolTipService.ToolTip="Copilot and Recall">
     <StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="Copilot and Recall" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" /><Border Background="{ThemeResource BadgeBrush}" CornerRadius="10" Padding="7,1" VerticalAlignment="Center"><TextBlock Text="{Binding AiCount}" FontSize="11" /></Border></StackPanel>
    </RadioButton>
    <RadioButton GroupName="DebloatTabs" Tag="Manufacturer" Checked="TabChecked" Style="{StaticResource StatTabStyle}" AutomationProperties.Name="PC maker apps" ToolTipService.ToolTip="Extras added by HP, Dell, Lenovo, ASUS and others">
     <StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="PC maker" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" /><Border Background="{ThemeResource BadgeBrush}" CornerRadius="10" Padding="7,1" VerticalAlignment="Center"><TextBlock Text="{Binding ManufacturerCount}" FontSize="11" /></Border></StackPanel>
    </RadioButton>
    <RadioButton GroupName="DebloatTabs" Tag="Components" Checked="TabChecked" Style="{StaticResource StatTabStyle}" AutomationProperties.Name="Windows components" ToolTipService.ToolTip="OneDrive and Edge">
     <StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="Components" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" /><Border Background="{ThemeResource BadgeBrush}" CornerRadius="10" Padding="7,1" VerticalAlignment="Center"><TextBlock Text="{Binding ComponentsCount}" FontSize="11" /></Border></StackPanel>
    </RadioButton>
    <RadioButton GroupName="DebloatTabs" Tag="Removed" Checked="TabChecked" Style="{StaticResource StatTabStyle}" AutomationProperties.Name="Removed" ToolTipService.ToolTip="Everything TidyWindow has removed, ready to put back">
     <StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="Removed" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" /><Border Background="{ThemeResource BadgeBrush}" CornerRadius="10" Padding="7,1" VerticalAlignment="Center"><TextBlock Text="{Binding RemovedCount}" FontSize="11" /></Border></StackPanel>
    </RadioButton>
   </StackPanel>
  </Grid>

  <!-- Search, selection and the remove button -->
  <Grid Grid.Row="2" ColumnSpacing="12" Visibility="{Binding ListVisibility}">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*" MaxWidth="360" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
   <TextBox x:Name="SearchBox" PlaceholderText="Search apps" TextChanged="QueryChanged" AutomationProperties.Name="Search apps" VerticalAlignment="Center" />
   <TextBlock Grid.Column="1" Text="{Binding Summary}" Style="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center" TextWrapping="NoWrap" />
   <TextBlock Grid.Column="3" Text="{Binding SelectedText}" Style="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center" TextWrapping="NoWrap" />
   <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
    <Button Click="SuggestClick" IsEnabled="{Binding CanSuggest}" Padding="12,7" AutomationProperties.Name="Select the suggested apps" ToolTipService.ToolTip="Ticks apps almost nobody uses. Anything marked Careful is never ticked.">
     <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE762;" FontSize="12" /><TextBlock Text="Select suggested" FontSize="12" /></StackPanel>
    </Button>
    <Button Click="ClearClick" IsEnabled="{Binding HasSelection}" Padding="12,7" AutomationProperties.Name="Clear the selection">
     <TextBlock Text="Clear" FontSize="12" />
    </Button>
   </StackPanel>
   <Button Grid.Column="5" Click="RemoveClick" IsEnabled="{Binding CanRemove}" Style="{StaticResource AccentButtonStyle}" Padding="14,7" AutomationProperties.Name="Remove the selected apps">
    <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE74D;" FontSize="12" /><TextBlock Text="{Binding RemoveLabel}" FontSize="12" /></StackPanel>
   </Button>
  </Grid>

  <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" IsTabStop="False">
   <Grid>
    <StackPanel Visibility="{Binding ListVisibility}" Spacing="10" Margin="0,0,0,12">
     <TextBlock Text="{Binding TabNote}" Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" />
     <Border Style="{StaticResource Card}" Padding="0" VerticalAlignment="Top">
      <Grid>
       <ItemsControl ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource DebloatRowTemplate}" IsTabStop="False" AutomationProperties.Name="Apps" />
       <StackPanel Visibility="{Binding EmptyVisibility}" HorizontalAlignment="Center" Padding="24,56" Spacing="10">
        <Border Width="44" Height="44" CornerRadius="10" BorderThickness="1" BorderBrush="{ThemeResource LineBrush}" Background="{ThemeResource CanvasBrush}" HorizontalAlignment="Center">
         <FontIcon Glyph="{Binding EmptyGlyph}" FontSize="18" Foreground="{ThemeResource MutedBrush}" />
        </Border>
        <TextBlock Text="{Binding EmptyTitle}" Style="{StaticResource EmptyTitle}" />
        <TextBlock Text="{Binding EmptyText}" Style="{StaticResource Muted}" TextAlignment="Center" MaxWidth="360" />
       </StackPanel>
      </Grid>
     </Border>
     <Grid ColumnSpacing="10" Margin="2,2,2,0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
      <FontIcon Glyph="&#xE946;" FontSize="13" Foreground="{ThemeResource MutedBrush}" VerticalAlignment="Top" Margin="0,2,0,0" />
      <TextBlock Grid.Column="1" Text="{Binding FooterNote}" Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" />
     </Grid>
    </StackPanel>

    <!-- Removed -->
    <Border Style="{StaticResource Card}" Padding="0" Margin="0,0,0,12" VerticalAlignment="Top" Visibility="{Binding RemovedVisibility}">
     <Grid>
      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
      <Grid Padding="16,12" BorderBrush="{ThemeResource LineBrush}" BorderThickness="0,0,0,1">
       <TextBlock Text="Everything TidyWindow has removed is kept here, even after you close the app. Putting an item back lets Windows have it again and installs it from the Microsoft Store or WinGet where that is possible." Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" />
      </Grid>
      <ItemsControl Grid.Row="1" ItemsSource="{Binding Removed}" IsTabStop="False" AutomationProperties.Name="Removed items">
       <ItemsControl.ItemTemplate>
        <DataTemplate>
         <Border BorderBrush="{ThemeResource LineBrush}" BorderThickness="0,0,0,1" Padding="16,12" MinHeight="64">
          <Grid ColumnSpacing="14">
           <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
           <Border Width="36" Height="36" CornerRadius="8" BorderThickness="1" BorderBrush="{ThemeResource LineBrush}" Background="{ThemeResource CanvasBrush}" VerticalAlignment="Center">
            <FontIcon Glyph="{Binding Glyph}" FontSize="16" Foreground="{ThemeResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
           </Border>
           <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
            <TextBlock Text="{Binding Name}" Style="{StaticResource RowTitle}" local:TrimTip.Enabled="True" />
            <TextBlock Text="{Binding Sub}" Style="{StaticResource RowSub}" local:TrimTip.Enabled="True" />
           </StackPanel>
           <Button Grid.Column="2" Click="PutBackClick" IsEnabled="{Binding CanPutBack}" VerticalAlignment="Center" Padding="12,6" AutomationProperties.Name="{Binding AutomationName}" ToolTipService.ToolTip="Let Windows have it again and install it">
            <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE7A7;" FontSize="12" /><TextBlock Text="Put back" FontSize="12" /></StackPanel>
           </Button>
          </Grid>
         </Border>
        </DataTemplate>
       </ItemsControl.ItemTemplate>
      </ItemsControl>
      <StackPanel Grid.Row="1" Visibility="{Binding NoRemovedVisibility}" HorizontalAlignment="Center" Padding="24,56" Spacing="10">
       <Border Width="44" Height="44" CornerRadius="10" BorderThickness="1" BorderBrush="{ThemeResource LineBrush}" Background="{ThemeResource CanvasBrush}" HorizontalAlignment="Center">
        <FontIcon Glyph="&#xE73E;" FontSize="18" Foreground="{ThemeResource MutedBrush}" />
       </Border>
       <TextBlock Text="Nothing removed yet" Style="{StaticResource EmptyTitle}" />
       <TextBlock Text="When you remove something, it will be listed here." Style="{StaticResource Muted}" TextAlignment="Center" />
      </StackPanel>
     </Grid>
    </Border>
   </Grid>
  </ScrollViewer>

  <local:LoadingOverlay Grid.Row="3" IsActive="{Binding WorkOverlay}" Heading="{Binding WorkHeading}" Counter="{Binding WorkCounter}" Text="{Binding WorkText}" Steps="{Binding Progress}" />
 </Grid>
</UserControl>
