<UserControl x:Class="TidyWindow.Next.Desktop.BackgroundView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="using:TidyWindow.Next.Desktop"
 HorizontalContentAlignment="Stretch">
 <UserControl.Resources>
  <ResourceDictionary>
   <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="ms-appx:///Styles/ListStyles.xaml" /></ResourceDictionary.MergedDictionaries>

   <!-- One row for each thing Windows runs in the background. The line says what it is and has the switch; the small print opens underneath. -->
   <DataTemplate x:Key="BackgroundRowTemplate">
    <Border BorderBrush="{ThemeResource LineBrush}" BorderThickness="0,0,0,1">
     <StackPanel>
      <Grid Padding="16,12" MinHeight="64" ColumnSpacing="14" Background="Transparent" Tapped="RowTapped">
       <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
       </Grid.ColumnDefinitions>

       <Border Width="36" Height="36" CornerRadius="8" BorderThickness="1" BorderBrush="{ThemeResource LineBrush}" Background="{ThemeResource CanvasBrush}" VerticalAlignment="Center" Opacity="{Binding Dim}">
        <FontIcon Glyph="{Binding Glyph}" FontSize="16" Foreground="{ThemeResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
       </Border>

       <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
        <TextBlock Text="{Binding Name}" Style="{StaticResource RowTitle}" local:TrimTip.Enabled="True" Opacity="{Binding Dim}" />
        <TextBlock Text="{Binding Sub}" Style="{StaticResource RowSub}" local:TrimTip.Enabled="True" Opacity="{Binding Dim}" />
        <TextBlock Text="{Binding Note}" Visibility="{Binding NoteVisibility}" FontSize="12" Foreground="{ThemeResource MutedBrush}" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
        <TextBlock Text="Windows turned this back on after you turned it off." Visibility="{Binding RevertedVisibility}" FontSize="12" Foreground="{ThemeResource WarnBrush}" TextWrapping="Wrap" Margin="0,2,0,0" />
       </StackPanel>

       <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Visibility="{Binding RunningVisibility}">
         <Ellipse Width="6" Height="6" Fill="{ThemeResource GoodBrush}" VerticalAlignment="Center" />
         <TextBlock Text="Running" FontSize="12" Foreground="{ThemeResource GoodBrush}" />
        </StackPanel>
        <Border Visibility="{Binding PartlyVisibility}" Background="{ThemeResource BadgeBrush}" CornerRadius="10" Padding="8,2" VerticalAlignment="Center" ToolTipService.ToolTip="Some parts of this are off and some are still allowed. Turn it off to switch off all of it."><TextBlock Text="Partly off" FontSize="11" Foreground="{ThemeResource MutedBrush}" /></Border>
        <Border Visibility="{Binding CarefulVisibility}" Background="{ThemeResource WarnSoftBrush}" CornerRadius="10" Padding="8,2" VerticalAlignment="Center" ToolTipService.ToolTip="Turning this off can affect a feature. You will be asked first."><TextBlock Text="Careful" FontSize="11" Foreground="{ThemeResource WarnBrush}" /></Border>
        <FontIcon Glyph="&#xE7EF;" FontSize="13" Foreground="{ThemeResource MutedBrush}" VerticalAlignment="Center" ToolTipService.ToolTip="Changing this asks for administrator permission" />
       </StackPanel>

       <Grid Grid.Column="3" VerticalAlignment="Center" MinWidth="44">
        <ToggleSwitch IsOn="{Binding Enabled, Mode=TwoWay}" IsEnabled="{Binding CanToggle}" Visibility="{Binding ToggleVisibility}" Toggled="ToggleChanged" OnContent="" OffContent="" MinWidth="0" HorizontalAlignment="Right" Margin="0,0,-8,0" AutomationProperties.Name="{Binding AutomationName}" />
        <FontIcon Glyph="&#xE72E;" FontSize="14" Visibility="{Binding LockVisibility}" Foreground="{ThemeResource MutedBrush}" HorizontalAlignment="Right" Margin="0,0,10,0" ToolTipService.ToolTip="Other things rely on this, so it cannot be turned off here" />
       </Grid>

       <Button Grid.Column="4" Click="DetailsClick" Padding="8" Background="Transparent" BorderThickness="0" VerticalAlignment="Center" AutomationProperties.Name="{Binding DetailsName}" ToolTipService.ToolTip="Details">
        <FontIcon Glyph="{Binding Chevron}" FontSize="12" Foreground="{ThemeResource MutedBrush}" />
       </Button>
      </Grid>

      <!-- Opened with the arrow or by clicking the row. -->
      <Border Visibility="{Binding DetailsVisibility}" Margin="66,0,16,14" Padding="14,12,14,4" CornerRadius="8" BorderThickness="1" BorderBrush="{ThemeResource LineBrush}" Background="{ThemeResource CanvasBrush}">
       <ItemsControl ItemsSource="{Binding Facts}" IsTabStop="False">
        <ItemsControl.ItemTemplate>
         <DataTemplate>
          <Grid ColumnSpacing="14" Margin="0,0,0,8">
           <Grid.ColumnDefinitions><ColumnDefinition Width="110" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
           <TextBlock Text="{Binding Label}" FontSize="12" Foreground="{ThemeResource MutedBrush}" />
           <TextBlock Grid.Column="1" Text="{Binding Value}" Visibility="{Binding PlainVisibility}" FontSize="12" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
           <TextBlock Grid.Column="1" Text="{Binding Value}" Visibility="{Binding MonoVisibility}" FontFamily="{StaticResource MonoFont}" FontSize="11" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
          </Grid>
         </DataTemplate>
        </ItemsControl.ItemTemplate>
       </ItemsControl>
      </Border>
     </StackPanel>
    </Border>
   </DataTemplate>
  </ResourceDictionary>
 </UserControl.Resources>

 <Grid RowSpacing="16">
  <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>

  <!-- Title -->
  <Grid ColumnSpacing="12">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
   <StackPanel Spacing="4" VerticalAlignment="Center">
    <TextBlock Text="Quiet Windows" Style="{StaticResource PageTitle}" />
    <TextBlock Text="Turn off what Windows runs in the background. Every change can be undone." Style="{StaticResource Muted}" />
   </StackPanel>
   <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
    <TextBlock Text="{Binding CheckedText}" Style="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center" TextWrapping="NoWrap" />
    <Button Click="ScanClick" IsEnabled="{Binding CanScan}" Padding="12,7" VerticalAlignment="Center" AutomationProperties.Name="Check again">
     <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE72C;" FontSize="12" /><TextBlock Text="{Binding ScanLabel}" FontSize="12" /></StackPanel>
    </Button>
   </StackPanel>
  </Grid>

  <!-- Four groups as slim tabs, each with its count -->
  <Grid Grid.Row="1" BorderBrush="{ThemeResource LineBrush}" BorderThickness="0,0,0,1" Margin="0,-4,0,0">
   <StackPanel Orientation="Horizontal">
    <RadioButton GroupName="BackgroundTabs" Tag="Telemetry" IsChecked="True" Checked="TabChecked" Style="{StaticResource StatTabStyle}" AutomationProperties.Name="Telemetry" ToolTipService.ToolTip="Diagnostic data and usage reports sent to Microsoft">
     <StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="Telemetry" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" /><Border Background="{ThemeResource BadgeBrush}" CornerRadius="10" Padding="7,1" VerticalAlignment="Center"><TextBlock Text="{Binding TelemetryCount}" FontSize="11" /></Border></StackPanel>
    </RadioButton>
    <RadioButton GroupName="BackgroundTabs" Tag="Ai" Checked="TabChecked" Style="{StaticResource StatTabStyle}" AutomationProperties.Name="Windows AI" ToolTipService.ToolTip="Features that look at your screen or run AI on this PC">
     <StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="Windows AI" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" /><Border Background="{ThemeResource BadgeBrush}" CornerRadius="10" Padding="7,1" VerticalAlignment="Center"><TextBlock Text="{Binding AiCount}" FontSize="11" /></Border></StackPanel>
    </RadioButton>
    <RadioButton GroupName="BackgroundTabs" Tag="Optional" Checked="TabChecked" Style="{StaticResource StatTabStyle}" AutomationProperties.Name="Optional" ToolTipService.ToolTip="Features many people never use">
     <StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="Optional" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" /><Border Background="{ThemeResource BadgeBrush}" CornerRadius="10" Padding="7,1" VerticalAlignment="Center"><TextBlock Text="{Binding OptionalCount}" FontSize="11" /></Border></StackPanel>
    </RadioButton>
    <RadioButton GroupName="BackgroundTabs" Tag="Changes" Checked="TabChecked" Style="{StaticResource StatTabStyle}" AutomationProperties.Name="Turned off" ToolTipService.ToolTip="Everything TidyWindow has turned off, ready to turn back on">
     <StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="Turned off" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" /><Border Background="{ThemeResource BadgeBrush}" CornerRadius="10" Padding="7,1" VerticalAlignment="Center"><TextBlock Text="{Binding ChangesCount}" FontSize="11" /></Border></StackPanel>
    </RadioButton>
   </StackPanel>
  </Grid>

  <!-- Search and the On / Off filter -->
  <Grid Grid.Row="2" ColumnSpacing="12" Visibility="{Binding ListVisibility}">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*" MaxWidth="420" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
   <TextBox x:Name="SearchBox" PlaceholderText="Search by name or the name in Task Manager" TextChanged="QueryChanged" AutomationProperties.Name="Search background items" VerticalAlignment="Center" />
   <Border Grid.Column="2" BorderBrush="{ThemeResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="3" VerticalAlignment="Center">
    <StackPanel Orientation="Horizontal" Spacing="2">
     <RadioButton GroupName="BackgroundFilter" Tag="All" IsChecked="True" Checked="FilterChecked" Content="All" Style="{StaticResource SegmentStyle}" />
     <RadioButton GroupName="BackgroundFilter" Tag="On" Checked="FilterChecked" Content="On" Style="{StaticResource SegmentStyle}" ToolTipService.ToolTip="Only what is still allowed to run" />
     <RadioButton GroupName="BackgroundFilter" Tag="Off" Checked="FilterChecked" Content="Off" Style="{StaticResource SegmentStyle}" ToolTipService.ToolTip="Only what is turned off" />
    </StackPanel>
   </Border>
  </Grid>

  <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" IsTabStop="False">
   <Grid>
    <!-- Telemetry, Windows AI and Optional share one list -->
    <StackPanel Visibility="{Binding ListVisibility}" Spacing="10" Margin="0,0,0,12">
     <Grid ColumnSpacing="12">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <TextBlock Text="{Binding TabNote}" Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" />
      <TextBlock Grid.Column="1" Text="{Binding Summary}" Style="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center" TextWrapping="NoWrap" />
     </Grid>
     <Border Style="{StaticResource Card}" Padding="0" VerticalAlignment="Top">
      <Grid>
       <ItemsControl ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource BackgroundRowTemplate}" IsTabStop="False" AutomationProperties.Name="Background items" />
       <StackPanel Visibility="{Binding EmptyVisibility}" HorizontalAlignment="Center" Padding="24,56" Spacing="10">
        <Border Width="44" Height="44" CornerRadius="10" BorderThickness="1" BorderBrush="{ThemeResource LineBrush}" Background="{ThemeResource CanvasBrush}" HorizontalAlignment="Center">
         <FontIcon Glyph="{Binding EmptyGlyph}" FontSize="18" Foreground="{ThemeResource MutedBrush}" />
        </Border>
        <TextBlock Text="{Binding EmptyTitle}" Style="{StaticResource EmptyTitle}" />
        <TextBlock Text="{Binding EmptyText}" Style="{StaticResource Muted}" TextAlignment="Center" MaxWidth="360" />
       </StackPanel>
      </Grid>
     </Border>
     <Grid ColumnSpacing="10" Margin="2,2,2,0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
      <FontIcon Glyph="&#xE946;" FontSize="13" Foreground="{ThemeResource MutedBrush}" VerticalAlignment="Top" Margin="0,2,0,0" />
      <TextBlock Grid.Column="1" Text="{Binding FooterNote}" Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" />
     </Grid>
    </StackPanel>

    <!-- Turned off -->
    <Border Style="{StaticResource Card}" Padding="0" Margin="0,0,0,12" VerticalAlignment="Top" Visibility="{Binding ChangesVisibility}">
     <Grid>
      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
      <Grid Padding="16,12" ColumnSpacing="12" BorderBrush="{ThemeResource LineBrush}" BorderThickness="0,0,0,1">
       <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
       <TextBlock Text="Everything TidyWindow has turned off is kept here, even after you close the app. Turning an item back on puts it exactly as it was before." Style="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center" />
       <Button Grid.Column="1" Click="RestoreAllClick" IsEnabled="{Binding CanRestore}" Padding="12,7" VerticalAlignment="Center" AutomationProperties.Name="Turn everything back on">
        <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE7A7;" FontSize="12" /><TextBlock Text="Turn everything back on" FontSize="12" /></StackPanel>
       </Button>
      </Grid>
      <ItemsControl Grid.Row="1" ItemsSource="{Binding Changes}" IsTabStop="False" AutomationProperties.Name="Items turned off">
       <ItemsControl.ItemTemplate>
        <DataTemplate>
         <Border BorderBrush="{ThemeResource LineBrush}" BorderThickness="0,0,0,1" Padding="16,12" MinHeight="64">
          <Grid ColumnSpacing="14">
           <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
           <local:AppIcon Source="{Binding Icon}" Glyph="{Binding Glyph}" />
           <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
            <TextBlock Text="{Binding Name}" Style="{StaticResource RowTitle}" local:TrimTip.Enabled="True" />
            <TextBlock Text="{Binding Sub}" Style="{StaticResource RowSub}" local:TrimTip.Enabled="True" />
           </StackPanel>
           <Button Grid.Column="2" Click="TurnBackOnClick" VerticalAlignment="Center" Padding="12,6" AutomationProperties.Name="{Binding AutomationName}" ToolTipService.ToolTip="Allow this to run again">
            <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE7A7;" FontSize="12" /><TextBlock Text="Turn back on" FontSize="12" /></StackPanel>
           </Button>
          </Grid>
         </Border>
        </DataTemplate>
       </ItemsControl.ItemTemplate>
      </ItemsControl>
      <StackPanel Grid.Row="1" Visibility="{Binding NoChangesVisibility}" HorizontalAlignment="Center" Padding="24,56" Spacing="10">
       <Border Width="44" Height="44" CornerRadius="10" BorderThickness="1" BorderBrush="{ThemeResource LineBrush}" Background="{ThemeResource CanvasBrush}" HorizontalAlignment="Center">
        <FontIcon Glyph="&#xE73E;" FontSize="18" Foreground="{ThemeResource MutedBrush}" />
       </Border>
       <TextBlock Text="Nothing turned off yet" Style="{StaticResource EmptyTitle}" />
       <TextBlock Text="When you turn something off, it will be listed here." Style="{StaticResource Muted}" TextAlignment="Center" />
      </StackPanel>
     </Grid>
    </Border>
   </Grid>
  </ScrollViewer>

  <local:LoadingOverlay Grid.Row="3" IsActive="{Binding ScanOverlay}" Text="Checking what Windows runs in the background…" />
 </Grid>
</UserControl>
