<UserControl x:Class="TidyWindow.Next.Desktop.CleanupView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="using:TidyWindow.Next.Desktop"
 HorizontalContentAlignment="Stretch">
 <Grid RowSpacing="16">
  <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
  <Grid ColumnSpacing="10">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
   <StackPanel Spacing="4" VerticalAlignment="Center">
        <TextBlock Text="Cleanup" Style="{StaticResource PageTitle}" />
        <TextBlock Text="Clear caches and temporary files. You can undo a clean afterwards." Style="{StaticResource Muted}" />
       </StackPanel>
   <Button Grid.Column="1" Click="EstimateClick" IsEnabled="{Binding CanEstimate}" Padding="12,7" ToolTipService.ToolTip="Ask Windows how much its update files could free. It can take a few minutes, and you can keep working meanwhile.">
    <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE8EF;" FontSize="12" /><TextBlock Text="{Binding EstimateLabel}" FontSize="12" /></StackPanel>
   </Button>
   <Button Grid.Column="2" Click="ScanClick" IsEnabled="{Binding CanScan}" Padding="12,7">
    <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE72C;" FontSize="12" /><TextBlock Text="{Binding ScanLabel}" FontSize="12" /></StackPanel>
   </Button>
   <Button Grid.Column="3" Click="CleanClick" IsEnabled="{Binding CanClean}" Style="{StaticResource AccentButtonStyle}" Padding="14,7" AutomationProperties.Name="Clean the selected items">
    <TextBlock Text="{Binding CleanLabel}" FontSize="12" />
   </Button>
  </Grid>
  <StackPanel Grid.Row="1" Spacing="10">
   <TextBlock Text="{Binding Status}" FontSize="12" Foreground="{ThemeResource MutedBrush}" TextWrapping="Wrap" />
   <TextBlock Text="{Binding AdminNote}" Visibility="{Binding AdminVisibility}" FontSize="12" Foreground="{ThemeResource MutedBrush}" TextWrapping="Wrap" />
   <Border Style="{StaticResource Card}" Padding="16,14" Visibility="{Binding CleaningVisibility}">
    <StackPanel Spacing="10">
     <Grid ColumnSpacing="12">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal" Spacing="10">
       <ProgressRing IsActive="True" Width="18" Height="18" VerticalAlignment="Center" />
       <TextBlock Text="{Binding CleanStep}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" />
      </StackPanel>
      <TextBlock Grid.Column="1" Text="{Binding CleanElapsed}" FontSize="12" Foreground="{ThemeResource MutedBrush}" VerticalAlignment="Center" AutomationProperties.Name="Time elapsed" />
     </Grid>
     <ProgressBar Minimum="0" Maximum="100" Value="{Binding CleanValue}" IsIndeterminate="{Binding CleanIndeterminate}" />
     <TextBlock Text="{Binding CleanHint}" Visibility="{Binding HintVisibility}" FontSize="12" Foreground="{ThemeResource MutedBrush}" TextWrapping="Wrap" />
    </StackPanel>
   </Border>
   <Button Click="UndoClick" Visibility="{Binding UndoVisibility}" IsEnabled="{Binding CanScan}" Padding="12,7" FontSize="12" HorizontalAlignment="Left">
    <TextBlock Text="{Binding UndoText}" FontSize="12" />
   </Button>
  </StackPanel>
  <Grid Grid.Row="2">
   <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,-12,0">
    <StackPanel Spacing="18" Padding="0,0,12,12">
     <ItemsControl ItemsSource="{Binding Groups}" IsEnabled="{Binding CanScan}" AutomationProperties.Name="Things that can be cleaned">
      <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="18" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate><DataTemplate>
       <StackPanel Spacing="8">
        <TextBlock Text="{Binding Name}" Style="{StaticResource GroupLabel}" />
        <Border Style="{StaticResource Card}" Padding="0">
         <ItemsControl ItemsSource="{Binding Rows}">
          <ItemsControl.ItemTemplate><DataTemplate>
           <Border BorderBrush="{ThemeResource LineBrush}" BorderThickness="0,0,0,1">
            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" MinWidth="0" Padding="12,0,0,0" Margin="14,0,14,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center" AutomationProperties.Name="{Binding AutomationName}">
             <Grid ColumnSpacing="14" Padding="0,12">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <StackPanel Spacing="3" VerticalAlignment="Center">
               <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="{Binding Name}" Style="{StaticResource ItemTitle}" local:TrimTip.Enabled="True" />
                <Border Visibility="{Binding AdminVisibility}" Background="{ThemeResource BadgeBrush}" CornerRadius="4" Padding="6,1" VerticalAlignment="Center"><TextBlock Text="Needs admin" FontSize="11" Foreground="{ThemeResource MutedBrush}" /></Border>
                <Border Visibility="{Binding ReviewVisibility}" Background="{ThemeResource BadgeBrush}" CornerRadius="4" Padding="6,1" VerticalAlignment="Center">
                 <TextBlock Text="{Binding ReviewText}" FontSize="11" Foreground="{ThemeResource MutedBrush}" />
                </Border>
               </StackPanel>
               <TextBlock Text="{Binding Detail}" FontSize="12" Foreground="{ThemeResource MutedBrush}" TextWrapping="Wrap" />
              </StackPanel>
              <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" Spacing="2">
               <TextBlock Text="{Binding SizeText}" Style="{StaticResource ItemTitle}" TextAlignment="Right" />
               <TextBlock Text="{Binding FilesText}" FontSize="11" Foreground="{ThemeResource MutedBrush}" TextAlignment="Right" />
               <TextBlock Text="{Binding StateText}" Visibility="{Binding StateVisibility}" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" TextAlignment="Right" />
              </StackPanel>
             </Grid>
            </CheckBox>
           </Border>
          </DataTemplate></ItemsControl.ItemTemplate>
         </ItemsControl>
        </Border>
       </StackPanel>
      </DataTemplate></ItemsControl.ItemTemplate>
     </ItemsControl>
    </StackPanel>
   </ScrollViewer>
   <StackPanel Visibility="{Binding EmptyVisibility}" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="380" Padding="24" Spacing="6">
    <TextBlock Text="Nothing to clean right now" Style="{StaticResource EmptyTitle}" />
    <TextBlock Text="Your caches and temporary files are already tidy." Style="{StaticResource Muted}" TextAlignment="Center" />
   </StackPanel>
   <local:LoadingOverlay IsActive="{Binding ScanOverlay}" Text="Looking for things to clean…" />
  </Grid>
 </Grid>
</UserControl>
