<UserControl x:Class="TidyWindow.Next.Desktop.HealthView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="using:TidyWindow.Next.Desktop"
 HorizontalContentAlignment="Stretch">
 <UserControl.Resources>
  <ResourceDictionary>
   <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="ms-appx:///Styles/ListStyles.xaml" /><ResourceDictionary Source="ms-appx:///Styles/PageStyles.xaml" /></ResourceDictionary.MergedDictionaries>

   <!-- A small word with a hairline outline, the way Lab shows the settings in force. -->
   <Style x:Key="Tag" TargetType="Border">
    <Setter Property="BorderBrush" Value="{ThemeResource LineBrush}" /><Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="10" /><Setter Property="Padding" Value="9,2" /><Setter Property="VerticalAlignment" Value="Center" />
   </Style>

   <!-- A line of small type under a heading, with what it is for. -->
   <Style x:Key="PartNote" TargetType="TextBlock" BasedOn="{StaticResource Muted}"><Setter Property="FontSize" Value="12" /></Style>

   <!-- One device: who it is and how it is doing on the first line, the answer underneath once it has been checked, and the way in to more at the bottom. -->
   <DataTemplate x:Key="DeviceTemplate">
    <Border Style="{StaticResource Card}" Padding="0">
     <StackPanel>
      <Grid Padding="20,16" ColumnSpacing="16">
       <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
       <!-- Health is the dot on the tile's corner, the way the package manager cards on Overview show it. -->
       <Grid Width="48" Height="48" VerticalAlignment="Top">
        <Border CornerRadius="10" BorderThickness="1" BorderBrush="{ThemeResource LineBrush}" Background="{ThemeResource CanvasBrush}">
         <FontIcon Glyph="{Binding Glyph}" FontSize="20" Foreground="{ThemeResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw" />
        </Border>
        <Ellipse Width="12" Height="12" Margin="0,0,-4,-4" HorizontalAlignment="Right" VerticalAlignment="Bottom" Fill="{ThemeResource GoodBrush}" Stroke="{ThemeResource PanelBrush}" StrokeThickness="2" Visibility="{Binding GoodVisibility}" AutomationProperties.AccessibilityView="Raw" />
        <Ellipse Width="12" Height="12" Margin="0,0,-4,-4" HorizontalAlignment="Right" VerticalAlignment="Bottom" Fill="{ThemeResource WarnBrush}" Stroke="{ThemeResource PanelBrush}" StrokeThickness="2" Visibility="{Binding WarnVisibility}" AutomationProperties.AccessibilityView="Raw" />
       </Grid>
       <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal" Spacing="10">
         <TextBlock Text="{Binding Title}" Style="{StaticResource RowTitle}" VerticalAlignment="Center" />
         <Border Style="{StaticResource Tag}">
          <StackPanel Orientation="Horizontal" Spacing="7">
           <Ellipse Style="{StaticResource StateDot}" Visibility="{Binding GoodVisibility}" Fill="{ThemeResource GoodBrush}" />
           <Ellipse Style="{StaticResource StateDot}" Visibility="{Binding WarnVisibility}" Fill="{ThemeResource WarnBrush}" />
           <Ellipse Style="{StaticResource StateDot}" Visibility="{Binding MutedVisibility}" Fill="{ThemeResource MutedBrush}" />
           <TextBlock Text="{Binding StatusWord}" FontSize="11" />
          </StackPanel>
         </Border>
        </StackPanel>
        <TextBlock Text="{Binding Summary}" Style="{StaticResource RowSub}" TextWrapping="Wrap" TextTrimming="None" AutomationProperties.LiveSetting="Polite" />
       </StackPanel>
       <Button Grid.Column="2" Click="CheckClick" IsEnabled="{Binding CanCheck}" Visibility="{Binding ButtonVisibility}" Style="{StaticResource PrimaryButton}" MinWidth="150" VerticalAlignment="Center" AutomationProperties.Name="Get battery health">
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center"><FontIcon Glyph="&#xE768;" FontSize="11" /><TextBlock Text="{Binding ButtonText}" /></StackPanel>
       </Button>
      </Grid>

      <!-- While it reads -->
      <Border Visibility="{Binding BusyVisibility}" BorderBrush="{ThemeResource LineBrush}" BorderThickness="0,1,0,0" Padding="20,14">
       <StackPanel Orientation="Horizontal" Spacing="10">
        <ProgressRing IsActive="True" Width="14" Height="14" VerticalAlignment="Center" />
        <TextBlock Text="Reading the battery…" FontSize="12" Foreground="{ThemeResource MutedBrush}" VerticalAlignment="Center" />
       </StackPanel>
      </Border>

      <!-- The answer -->
      <Border Visibility="{Binding ResultVisibility}" BorderBrush="{ThemeResource LineBrush}" BorderThickness="0,1,0,0" Padding="20,16">
       <StackPanel Spacing="10">
        <StackPanel Orientation="Horizontal" Spacing="6" AutomationProperties.Name="{Binding AutomationName}">
         <TextBlock Text="{Binding PercentText}" FontFamily="{StaticResource MonoFont}" FontSize="26" FontWeight="SemiBold" CharacterSpacing="-20" />
         <TextBlock Text="%" FontSize="12" Foreground="{ThemeResource MutedBrush}" VerticalAlignment="Bottom" Margin="0,0,0,5" />
         <TextBlock Text="of its original capacity" FontSize="12" Foreground="{ThemeResource MutedBrush}" VerticalAlignment="Bottom" Margin="8,0,0,5" />
        </StackPanel>
        <ProgressBar Minimum="0" Maximum="100" Value="{Binding Percent}" Foreground="{ThemeResource TextFillColorPrimaryBrush}" Background="{ThemeResource BadgeBrush}" AutomationProperties.AccessibilityView="Raw" />
       </StackPanel>
      </Border>

      <!-- The way in to more, along the bottom edge -->
      <Border Visibility="{Binding FooterVisibility}" BorderBrush="{ThemeResource LineBrush}" BorderThickness="0,1,0,0" Padding="12,4">
       <HyperlinkButton Click="DetailsClick" Padding="8,4" FontSize="12" HorizontalAlignment="Left" AutomationProperties.Name="View details about the battery">
        <StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="View details" FontSize="12" /><FontIcon Glyph="&#xE76C;" FontSize="9" /></StackPanel>
       </HyperlinkButton>
      </Border>
     </StackPanel>
    </Border>
   </DataTemplate>

   <!-- One battery in the details: the answer first, then the facts behind it. -->
   <DataTemplate x:Key="BatteryTemplate">
    <StackPanel Spacing="12">
     <TextBlock Text="{Binding Title}" Visibility="{Binding TitleVisibility}" Style="{StaticResource SectionTitle}" />
     <Border Style="{StaticResource Card}" Padding="0">
      <Grid>
       <Grid.ColumnDefinitions><ColumnDefinition Width="4" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
       <Grid>
        <Border Visibility="{Binding GoodVisibility}" Background="{ThemeResource GoodBrush}" CornerRadius="8,0,0,8" />
        <Border Visibility="{Binding WarnVisibility}" Background="{ThemeResource WarnBrush}" CornerRadius="8,0,0,8" />
        <Border Visibility="{Binding NeutralVisibility}" Background="{ThemeResource LineBrush}" CornerRadius="8,0,0,8" />
       </Grid>
       <StackPanel Grid.Column="1" Padding="20,14" Spacing="8">
        <TextBlock Text="{Binding Headline}" FontSize="18" FontWeight="SemiBold" CharacterSpacing="-10" TextWrapping="Wrap" />
        <TextBlock Text="{Binding Subline}" Style="{StaticResource Muted}" />
        <ProgressBar Minimum="0" Maximum="100" Value="{Binding Percent}" Visibility="{Binding BarVisibility}" Foreground="{ThemeResource TextFillColorPrimaryBrush}" Background="{ThemeResource BadgeBrush}" Margin="0,4,0,0" AutomationProperties.AccessibilityView="Raw" />
       </StackPanel>
      </Grid>
     </Border>
     <Border Style="{StaticResource Card}" Padding="20,16,20,8">
      <ItemsControl ItemsSource="{Binding Facts}" IsTabStop="False" AutomationProperties.Name="Battery facts">
       <ItemsControl.ItemTemplate>
        <DataTemplate>
         <Grid ColumnSpacing="14" Margin="0,0,0,10">
          <Grid.ColumnDefinitions><ColumnDefinition Width="130" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
          <TextBlock Text="{Binding Label}" FontSize="12" Foreground="{ThemeResource MutedBrush}" />
          <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="12" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
         </Grid>
        </DataTemplate>
       </ItemsControl.ItemTemplate>
      </ItemsControl>
     </Border>
    </StackPanel>
   </DataTemplate>
  </ResourceDictionary>
 </UserControl.Resources>

 <Grid RowSpacing="16">
  <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>

  <!-- The device list's header -->
  <StackPanel Spacing="4" Visibility="{Binding ListVisibility}">
   <TextBlock Text="Check how the hardware in this PC is holding up." Style="{StaticResource Muted}" />
  </StackPanel>

  <!-- The details' header: a way back, and the one thing to do here -->
  <Grid Visibility="{Binding DetailsVisibility}" ColumnSpacing="12">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
   <StackPanel Spacing="6" VerticalAlignment="Center">
    <Button Click="BackClick" Background="Transparent" BorderThickness="0" Padding="8,4" HorizontalAlignment="Left" Margin="-8,0,0,0" AutomationProperties.Name="Back to Health" ToolTipService.ToolTip="Back to Health">
     <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE72B;" FontSize="11" Foreground="{ThemeResource MutedBrush}" /><TextBlock Text="Health" FontSize="12" Foreground="{ThemeResource MutedBrush}" /></StackPanel>
    </Button>
    <TextBlock Text="Battery" Style="{StaticResource PageTitle}" />
   </StackPanel>
   <Button Grid.Column="1" Click="CheckClick" IsEnabled="{Binding Battery.CanCheck}" Padding="12,7" FontSize="12" VerticalAlignment="Bottom" AutomationProperties.Name="Check the battery again">
    <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE72C;" FontSize="12" /><TextBlock Text="{Binding Battery.ButtonText}" FontSize="12" /></StackPanel>
   </Button>
  </Grid>

  <!-- The list of devices -->
  <ScrollViewer Grid.Row="1" Style="{StaticResource PageScrollViewerStyle}" VerticalScrollBarVisibility="Auto" IsTabStop="False" Visibility="{Binding ListVisibility}">
   <StackPanel Spacing="32" Margin="0,0,0,12">
    <StackPanel Spacing="12">
     <StackPanel Spacing="3">
      <TextBlock Text="Devices" Style="{StaticResource SectionTitle}" />
      <TextBlock Text="Pick a device to check. Nothing here changes a setting or needs administrator permission." Style="{StaticResource PartNote}" />
     </StackPanel>
     <ItemsControl ItemsSource="{Binding Devices}" ItemTemplate="{StaticResource DeviceTemplate}" IsTabStop="False" AutomationProperties.Name="Devices">
      <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="12" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
     </ItemsControl>
    </StackPanel>
   </StackPanel>
  </ScrollViewer>

  <!-- The battery's details -->
  <ScrollViewer Grid.Row="1" Style="{StaticResource PageScrollViewerStyle}" VerticalScrollBarVisibility="Auto" IsTabStop="False" Visibility="{Binding DetailsVisibility}">
   <StackPanel Spacing="16" Margin="0,0,0,12">
    <!-- A check that failed after an earlier one worked: the earlier numbers stay, and this says why they may be out of date. -->
    <Border Visibility="{Binding Battery.FailedVisibility}" Background="{ThemeResource WarnSoftBrush}" CornerRadius="6" Padding="14,10">
     <Grid ColumnSpacing="10">
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
      <FontIcon Glyph="&#xE7BA;" FontSize="14" Foreground="{ThemeResource WarnBrush}" VerticalAlignment="Top" Margin="0,2,0,0" />
      <TextBlock Grid.Column="1" Text="{Binding Battery.FailureText}" FontSize="13" Foreground="{ThemeResource WarnBrush}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
     </Grid>
    </Border>

    <ItemsControl ItemsSource="{Binding Batteries}" ItemTemplate="{StaticResource BatteryTemplate}" IsTabStop="False" AutomationProperties.Name="Batteries">
     <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="24" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
    </ItemsControl>

    <StackPanel Spacing="8" Margin="2,8,2,0">
     <Grid ColumnSpacing="10">
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
      <FontIcon Glyph="&#xE946;" FontSize="13" Foreground="{ThemeResource MutedBrush}" VerticalAlignment="Top" Margin="0,2,0,0" />
      <StackPanel Grid.Column="1" Spacing="6">
       <TextBlock Text="Health is what the battery holds now when full, divided by what it held when it was new. It is the battery's own estimate, and it moves a little with temperature and with how recently it was fully charged and run down." Style="{StaticResource PartNote}" />
       <TextBlock Text="About 80% is where makers usually call a battery worn. Some loss is normal, and it comes on slowly. A cycle is one full charge's worth of use, spread over any number of top-ups. Not every battery reports one." Style="{StaticResource PartNote}" />
       <TextBlock Text="Checking only reads from the battery. Nothing changes, and no administrator permission is needed." Style="{StaticResource PartNote}" />
      </StackPanel>
     </Grid>
    </StackPanel>
   </StackPanel>
  </ScrollViewer>
 </Grid>
</UserControl>
