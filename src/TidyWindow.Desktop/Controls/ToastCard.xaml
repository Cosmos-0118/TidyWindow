<UserControl x:Class="TidyWindow.Next.Desktop.ToastCard"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="using:TidyWindow.Next.Desktop"
 HorizontalContentAlignment="Stretch" IsTabStop="False">
 <Border x:Name="Card" Background="{ThemeResource CanvasBrush}" BorderBrush="{ThemeResource LineBrush}" BorderThickness="1" CornerRadius="10"
  PointerEntered="PointerOver" PointerExited="PointerAway" GotFocus="FocusInside" LostFocus="FocusOutside"
  AutomationProperties.Name="{Binding Announcement}" AutomationProperties.LiveSetting="Polite">
  <Grid>
   <!-- The icon only sits beside the title. The detail and the buttons start at the card's own edge, so nothing below the title is pushed in by the icon.
        The first row is one 20px line: the icon box, the title's line height and the close button's centre all sit on it, so they stay level. -->
   <Grid Padding="16,14,10,14">
    <Grid.ColumnDefinitions><ColumnDefinition Width="20" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <Grid Width="20" Height="20" VerticalAlignment="Top" AutomationProperties.AccessibilityView="Raw">
     <FontIcon Glyph="&#xE73E;" FontSize="16" Foreground="{ThemeResource GoodBrush}" Visibility="{Binding SuccessVisibility}" HorizontalAlignment="Center" VerticalAlignment="Center" />
     <FontIcon Glyph="&#xE7BA;" FontSize="16" Foreground="{ThemeResource WarnBrush}" Visibility="{Binding WarningVisibility}" HorizontalAlignment="Center" VerticalAlignment="Center" />
     <FontIcon Glyph="&#xE946;" FontSize="16" Foreground="{ThemeResource MutedBrush}" Visibility="{Binding InfoVisibility}" HorizontalAlignment="Center" VerticalAlignment="Center" />
    </Grid>
    <!-- Shortened while closed, so a long message never makes a tall toast. Opening it shows everything, scrolling if the detail is very long. -->
    <Grid Grid.Column="1" ColumnSpacing="8" Margin="10,0,0,0">
     <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
     <TextBlock x:Name="TitleText" Text="{Binding Title}" Style="{StaticResource ItemTitle}" LineHeight="20" LineStackingStrategy="BlockLineHeight" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" IsTextTrimmedChanged="TrimmedChanged" />
     <TextBlock Grid.Column="1" Text="{Binding CountText}" Visibility="{Binding CountVisibility}" FontSize="12" Foreground="{ThemeResource MutedBrush}" VerticalAlignment="Top" LineHeight="20" LineStackingStrategy="BlockLineHeight" />
    </Grid>
    <!-- Copy and close are the same small quiet buttons, centred on the title line. Copy is an icon so it needs no row of its own. -->
    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Top" Margin="0,-4,0,0">
     <Button x:Name="CopyButton" Click="CopyClick" Visibility="Collapsed" Background="Transparent" BorderThickness="0" CornerRadius="6" Width="28" Height="28" Padding="0" AutomationProperties.Name="Copy this message" ToolTipService.ToolTip="Copy this message"><FontIcon x:Name="CopyIcon" Glyph="&#xE8C8;" FontSize="12" /></Button>
     <Button Click="DismissClick" Background="Transparent" BorderThickness="0" CornerRadius="6" Width="28" Height="28" Padding="0" AutomationProperties.Name="Dismiss" ToolTipService.ToolTip="Dismiss"><FontIcon Glyph="&#xE711;" FontSize="11" /></Button>
    </StackPanel>
    <TextBlock x:Name="DetailText" Grid.Row="1" Grid.ColumnSpan="3" Margin="0,6,6,0" Text="{Binding Detail}" Visibility="{Binding DetailVisibility}" Style="{StaticResource Muted}" FontSize="12" LineHeight="16" LineStackingStrategy="BlockLineHeight" TextWrapping="Wrap" MaxLines="4" TextTrimming="CharacterEllipsis" IsTextTrimmedChanged="TrimmedChanged" />
    <ScrollViewer x:Name="FullText" Grid.Row="1" Grid.ColumnSpan="3" Margin="0,6,0,0" Visibility="Collapsed" MaxHeight="240" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" IsTabStop="False">
     <TextBlock Text="{Binding Detail}" Padding="0,0,10,0" Style="{StaticResource Muted}" FontSize="12" LineHeight="16" LineStackingStrategy="BlockLineHeight" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
    </ScrollViewer>
    <!-- Shown only when there is a button, so a plain message has no empty strip under it. "Show more" is a quiet button that is pulled left by its own padding, so its text starts where the text above starts. -->
    <StackPanel x:Name="ActionsRow" Grid.Row="2" Grid.ColumnSpan="3" Orientation="Horizontal" Spacing="6" Margin="0,10,0,0" Visibility="Collapsed">
     <Button Content="{Binding ActionLabel}" Visibility="{Binding ActionVisibility}" Click="ActionClick" Style="{StaticResource AccentButtonStyle}" FontSize="12" Padding="14,5" VerticalAlignment="Center" />
     <Button x:Name="MoreButton" Content="Show more" Visibility="Collapsed" Click="MoreClick" Background="Transparent" BorderThickness="0" CornerRadius="6" FontSize="12" Padding="8,5" VerticalAlignment="Center" />
    </StackPanel>
   </Grid>
   <!-- Runs down to nothing so the person can see the toast is about to go. It stops while the toast is being read. -->
   <Border x:Name="BarTrack" Height="3" VerticalAlignment="Bottom" HorizontalAlignment="Stretch" Visibility="{Binding TimerVisibility}" Background="{ThemeResource BadgeBrush}" CornerRadius="0,0,10,10">
    <Border x:Name="BarFill" Background="{ThemeResource MutedBrush}" HorizontalAlignment="Stretch" />
   </Border>
  </Grid>
 </Border>
</UserControl>
