<UserControl x:Class="TidyWindow.Next.Desktop.ToastCard"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="using:TidyWindow.Next.Desktop"
 HorizontalContentAlignment="Stretch" IsTabStop="False">
 <Border x:Name="Card" Background="{ThemeResource CanvasBrush}" BorderBrush="{ThemeResource LineBrush}" BorderThickness="1" CornerRadius="10"
  PointerEntered="PointerOver" PointerExited="PointerAway" GotFocus="FocusInside" LostFocus="FocusOutside"
  AutomationProperties.Name="{Binding Announcement}" AutomationProperties.LiveSetting="Polite">
  <Grid>
   <Grid ColumnSpacing="12" Padding="16,14,10,16">
    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
    <Grid VerticalAlignment="Top" Margin="0,2,0,0" AutomationProperties.AccessibilityView="Raw">
     <FontIcon Glyph="&#xE73E;" FontSize="16" Foreground="{ThemeResource GoodBrush}" Visibility="{Binding SuccessVisibility}" />
     <FontIcon Glyph="&#xE7BA;" FontSize="16" Foreground="{ThemeResource WarnBrush}" Visibility="{Binding WarningVisibility}" />
     <FontIcon Glyph="&#xE946;" FontSize="16" Foreground="{ThemeResource MutedBrush}" Visibility="{Binding InfoVisibility}" />
    </Grid>
    <StackPanel Grid.Column="1" Spacing="3">
     <!-- Shortened while closed, so a long message never makes a tall toast. Opening it shows everything, scrolling if it is very long. -->
     <Grid ColumnSpacing="8" x:Name="ShortTitle">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <TextBlock x:Name="TitleText" Text="{Binding Title}" Style="{StaticResource ItemTitle}" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" IsTextTrimmedChanged="TrimmedChanged" />
      <TextBlock Grid.Column="1" Text="{Binding CountText}" Visibility="{Binding CountVisibility}" FontSize="12" Foreground="{ThemeResource MutedBrush}" VerticalAlignment="Center" />
     </Grid>
     <TextBlock x:Name="DetailText" Text="{Binding Detail}" Visibility="{Binding DetailVisibility}" Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" MaxLines="4" TextTrimming="CharacterEllipsis" IsTextTrimmedChanged="TrimmedChanged" />
     <ScrollViewer x:Name="FullText" Visibility="Collapsed" MaxHeight="240" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" IsTabStop="False">
      <StackPanel Spacing="6" Padding="0,0,10,0">
       <TextBlock Text="{Binding Title}" Style="{StaticResource ItemTitle}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
       <TextBlock Text="{Binding Detail}" Visibility="{Binding DetailVisibility}" Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
      </StackPanel>
     </ScrollViewer>
     <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,8,0,0">
      <Button Content="{Binding ActionLabel}" Visibility="{Binding ActionVisibility}" Click="ActionClick" FontSize="12" Padding="12,5" />
      <HyperlinkButton x:Name="MoreButton" Content="Show more" Visibility="Collapsed" Click="MoreClick" FontSize="12" Padding="8,4" />
      <HyperlinkButton x:Name="CopyButton" Content="Copy" Visibility="Collapsed" Click="CopyClick" FontSize="12" Padding="8,4" ToolTipService.ToolTip="Copy this message" />
     </StackPanel>
    </StackPanel>
    <Button Grid.Column="2" Click="DismissClick" Background="Transparent" BorderThickness="0" CornerRadius="6" VerticalAlignment="Top" Padding="6" AutomationProperties.Name="Dismiss" ToolTipService.ToolTip="Dismiss"><FontIcon Glyph="&#xE711;" FontSize="11" /></Button>
   </Grid>
   <!-- Runs down to nothing so the person can see the toast is about to go. It stops while the toast is being read. -->
   <Border x:Name="BarTrack" Height="3" VerticalAlignment="Bottom" HorizontalAlignment="Stretch" Visibility="{Binding TimerVisibility}" Background="{ThemeResource BadgeBrush}" CornerRadius="0,0,10,10">
    <Border x:Name="BarFill" Background="{ThemeResource MutedBrush}" HorizontalAlignment="Stretch" />
   </Border>
  </Grid>
 </Border>
</UserControl>
