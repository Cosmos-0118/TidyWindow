<UserControl x:Class="TidyWindow.Next.Desktop.SelectionBar"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 IsTabStop="False" HorizontalContentAlignment="Stretch" SizeChanged="BarResized">
 <!-- One strip for choosing several things, the same on every page. At rest it is just the tick for "select all"; once something is ticked it turns into a quiet
      panel that says how many, offers Clear, and shows the actions that work on the ticked things. The tick lines up with the ticks in the rows below. -->
 <Grid MinHeight="48">
  <Border x:Name="Fill" CornerRadius="8" BorderThickness="1" BorderBrush="{ThemeResource LineBrush}" Background="{ThemeResource PanelBrush}" Visibility="Collapsed" />
  <Border x:Name="Frame" Padding="12,0,12,0">
  <Grid x:Name="Layout" ColumnSpacing="16" RowSpacing="0" VerticalAlignment="Center">
   <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
   <Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
   <CheckBox x:Name="Master" IsThreeState="True" MinWidth="0" Padding="0" VerticalAlignment="Center" Click="MasterClick" />
   <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" MinHeight="32">
    <TextBlock x:Name="RestLabel" FontSize="13" Foreground="{ThemeResource MutedBrush}" VerticalAlignment="Center" Tapped="LabelTapped" />
    <TextBlock x:Name="CountLabel" FontSize="13" FontWeight="Medium" VerticalAlignment="Center" Visibility="Collapsed" AutomationProperties.LiveSetting="Polite" />
    <StackPanel x:Name="HiddenNote" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center" Visibility="Collapsed">
     <FontIcon Glyph="&#xED1A;" FontSize="11" Foreground="{ThemeResource MutedBrush}" />
     <TextBlock x:Name="HiddenText" FontSize="12" Foreground="{ThemeResource MutedBrush}" />
    </StackPanel>
   </StackPanel>
   <StackPanel x:Name="ClearGroup" Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Visibility="Collapsed">
    <Border Width="1" Height="16" Background="{ThemeResource LineBrush}" Margin="0,0,2,0" />
    <Button x:Name="ClearButton" Click="ClearClicked" Background="Transparent" BorderThickness="0" Padding="10,5" FontSize="12" ToolTipService.ToolTip="Clear the selection" AutomationProperties.Name="Clear the selection">
     <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE711;" FontSize="11" VerticalAlignment="Center" /><TextBlock Text="Clear" FontSize="12" VerticalAlignment="Center" /></StackPanel>
    </Button>
   </StackPanel>
   <ContentPresenter x:Name="ActionsHost" Grid.Column="4" VerticalAlignment="Center" HorizontalAlignment="Right" />
  </Grid>
  </Border>
 </Grid>
</UserControl>
