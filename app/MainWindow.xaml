<Window x:Class="TidyWindow.Next.Desktop.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="TidyWindow">
 <Grid x:Name="Root" Background="{ThemeResource CanvasBrush}">
  <Grid.KeyboardAccelerators><KeyboardAccelerator Key="K" Modifiers="Control" Invoked="SearchShortcut" /></Grid.KeyboardAccelerators>
  <Grid.RowDefinitions><RowDefinition Height="40" /><RowDefinition Height="*" /></Grid.RowDefinitions>
  <Grid x:Name="TitleBar" Padding="20,0,140,0">
   <TextBlock Text="TidyWindow" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
  </Grid>
  <Grid Grid.Row="1">
   <Grid.ColumnDefinitions><ColumnDefinition x:Name="SidebarColumn" Width="184" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
   <Border BorderBrush="{ThemeResource LineBrush}" BorderThickness="0,0,1,0">
    <Grid Margin="10,20,10,12">
     <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
     <StackPanel Spacing="4">
     <Button x:Name="OverviewNav" Style="{StaticResource NavButton}" Click="OverviewClick" ToolTipService.ToolTip="Overview" AutomationProperties.Name="Overview">
      <StackPanel Orientation="Horizontal" Spacing="10"><FontIcon Glyph="&#xE80F;" FontSize="15" /><TextBlock x:Name="OverviewLabel" Text="Overview" FontSize="13" /></StackPanel>
     </Button>
     <Button x:Name="InstallNav" Style="{StaticResource NavButton}" Click="InstallClick" ToolTipService.ToolTip="Install apps (Ctrl+K)" AutomationProperties.Name="Install Hub">
      <StackPanel Orientation="Horizontal" Spacing="10"><FontIcon Glyph="&#xE7B8;" FontSize="15" /><TextBlock x:Name="InstallLabel" Text="Install Hub" FontSize="13" /></StackPanel>
     </Button>
     <Button x:Name="LogsNav" Style="{StaticResource NavButton}" Click="LogsClick" ToolTipService.ToolTip="Logs" AutomationProperties.Name="Logs">
      <StackPanel Orientation="Horizontal" Spacing="10"><FontIcon Glyph="&#xE81C;" FontSize="15" /><TextBlock x:Name="LogsLabel" Text="Logs" FontSize="13" /></StackPanel>
     </Button>
     </StackPanel>
     <Button Grid.Row="1" Style="{StaticResource NavButton}" ToolTipService.ToolTip="Appearance" AutomationProperties.Name="Appearance">
      <StackPanel Orientation="Horizontal" Spacing="10"><FontIcon Glyph="&#xE790;" FontSize="15" /><TextBlock x:Name="AppearanceLabel" Text="Appearance" FontSize="13" /></StackPanel>
      <Button.Flyout><MenuFlyout>
       <RadioMenuFlyoutItem x:Name="SystemThemeItem" Text="Use Windows theme" GroupName="Theme" Tag="System" Click="ThemeClick" />
       <RadioMenuFlyoutItem x:Name="LightThemeItem" Text="Light" GroupName="Theme" Tag="Light" Click="ThemeClick" />
       <RadioMenuFlyoutItem x:Name="DarkThemeItem" Text="Dark" GroupName="Theme" Tag="Dark" Click="ThemeClick" />
      </MenuFlyout></Button.Flyout>
     </Button>
    </Grid>
   </Border>
   <Grid x:Name="ContentArea" Grid.Column="1" Padding="36,24,36,28">
    <ScrollViewer x:Name="OverviewPage" HorizontalContentAlignment="Stretch" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
     <StackPanel HorizontalAlignment="Stretch" Spacing="24">
      <Grid>
       <TextBlock Text="Package managers" Style="{StaticResource PageTitle}" VerticalAlignment="Center" />
       <Button HorizontalAlignment="Right" Click="RefreshClick" IsEnabled="{Binding CanRefresh}" Padding="12,7">
        <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE72C;" FontSize="12" /><TextBlock Text="Refresh" FontSize="12" /></StackPanel>
       </Button>
      </Grid>
      <Grid>
       <Border Style="{StaticResource Card}" Padding="0">
        <ItemsControl ItemsSource="{Binding Managers}" AutomationProperties.Name="Package managers">
         <ItemsControl.ItemTemplate><DataTemplate>
          <Border BorderBrush="{ThemeResource LineBrush}" BorderThickness="0,0,0,1" Padding="18,18">
           <Grid ColumnSpacing="14">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /><ColumnDefinition Width="{Binding StatusColumnWidth}" /><ColumnDefinition Width="{Binding SetupColumnWidth}" /></Grid.ColumnDefinitions>
            <Image Grid.RowSpan="2" Source="{Binding Icon}" Width="32" Height="32" Stretch="Uniform" AutomationProperties.AccessibilityView="Raw" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
             <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" />
             <TextBlock Text="{Binding Version}" FontSize="12" Foreground="{ThemeResource MutedBrush}" />
            </StackPanel>
            <Button Grid.Column="{Binding StatusColumn}" Grid.Row="{Binding StatusRow}" Background="Transparent" BorderThickness="0" Padding="0,4" VerticalAlignment="Center" HorizontalAlignment="Left" ToolTipService.ToolTip="Status details">
             <StackPanel Orientation="Horizontal" Spacing="7"><Ellipse Width="5" Height="5" Fill="{Binding StatusBrush}" /><TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="{Binding StatusBrush}" /></StackPanel>
             <Button.Flyout><Flyout><ScrollViewer MaxHeight="220" MaxWidth="420"><TextBlock Text="{Binding Detail}" TextWrapping="Wrap" IsTextSelectionEnabled="True" FontSize="12" /></ScrollViewer></Flyout></Button.Flyout>
            </Button>
            <Button Grid.Column="3" Grid.RowSpan="2" Content="{Binding SetupAction}" IsEnabled="{Binding CanRecover}" Visibility="{Binding SetupVisibility}" Click="ManagerRecoveryClick" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="12" Padding="10,6" />
           </Grid>
          </Border>
         </DataTemplate></ItemsControl.ItemTemplate>
        </ItemsControl>
       </Border>
       <ProgressBar x:Name="DetectionProgress" IsIndeterminate="True" Visibility="Collapsed" Height="2" VerticalAlignment="Top" />
      </Grid>
      <StackPanel Spacing="10" Visibility="{Binding RecoveryVisibility}">
       <StackPanel Orientation="Horizontal" Spacing="10"><ProgressRing Width="14" Height="14" IsActive="{Binding Recovering}" Visibility="{Binding RecoveryProgressVisibility}" /><TextBlock Text="{Binding RecoveryMessage}" FontSize="13" TextWrapping="Wrap" /></StackPanel>
       <Expander Header="Details" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"><ScrollViewer MaxHeight="180"><TextBlock Text="{Binding RecoveryDetail}" FontSize="12" Foreground="{ThemeResource MutedBrush}" TextWrapping="Wrap" IsTextSelectionEnabled="True" /></ScrollViewer></Expander>
      </StackPanel>
     </StackPanel>
    </ScrollViewer>
    <Grid x:Name="InstallPage" Visibility="Collapsed" HorizontalAlignment="Stretch" RowSpacing="22">
     <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
     <TextBlock Text="Install apps" Style="{StaticResource PageTitle}" />
     <Grid x:Name="SearchControls" Grid.Row="1" ColumnSpacing="10" RowSpacing="8">
      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition x:Name="FilterColumn" Width="150" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <TextBox x:Name="SearchBox" PlaceholderText="Search apps or package IDs" MaxLength="100" Height="38" VerticalContentAlignment="Center" TextChanged="SearchTextChanged" KeyDown="SearchKeyDown" AutomationProperties.Name="Search packages" />
      <ComboBox x:Name="SourceFilter" Grid.Column="1" SelectedIndex="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" VerticalContentAlignment="Center" SelectionChanged="SourceChanged" AutomationProperties.Name="Package source">
       <ComboBoxItem Content="All sources" /><ComboBoxItem Content="WinGet" /><ComboBoxItem Content="Chocolatey" /><ComboBoxItem Content="Scoop" />
      </ComboBox>
      <Button x:Name="SearchButton" Grid.Column="2" Content="Search" Click="SearchClick" Padding="16,8" Height="38" />
     </Grid>
     <Grid Grid.Row="2" RowSpacing="12">
      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
      <Grid Visibility="{Binding CancelVisibility}">
       <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
        <ProgressRing IsActive="{Binding Searching}" Width="14" Height="14" /><TextBlock Text="Searching…" FontSize="12" Foreground="{ThemeResource MutedBrush}" VerticalAlignment="Center" />
       </StackPanel>
       <Button Content="Cancel" Click="CancelSearchClick" HorizontalAlignment="Right" FontSize="12" Padding="10,4" />
      </Grid>
      <Expander Grid.Row="1" Header="Search needs attention" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Visibility="{Binding ErrorVisibility}">
       <ScrollViewer MaxHeight="120"><TextBlock Text="{Binding Errors}" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource ErrorBrush}" IsTextSelectionEnabled="True" /></ScrollViewer>
      </Expander>
      <Grid Grid.Row="2">
       <Grid Visibility="{Binding ResultsVisibility}">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Border Visibility="{Binding ResultsHeaderVisibility}" Height="36" BorderBrush="{ThemeResource LineBrush}" BorderThickness="0,0,0,1" Padding="12,0">
         <Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="100" /><ColumnDefinition Width="100" /><ColumnDefinition Width="85" /></Grid.ColumnDefinitions>
          <TextBlock Text="Name" Style="{StaticResource Muted}" VerticalAlignment="Center" />
          <TextBlock Grid.Column="1" Text="Version" Style="{StaticResource Muted}" VerticalAlignment="Center" />
          <TextBlock Grid.Column="2" Text="Source" Style="{StaticResource Muted}" VerticalAlignment="Center" />
         </Grid>
        </Border>
        <ListView Grid.Row="1" ItemsSource="{Binding Packages}" SelectionMode="None" IsItemClickEnabled="False" Padding="0" HorizontalContentAlignment="Stretch" AutomationProperties.Name="Package search results">
         <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="0" /><Setter Property="MinHeight" Value="0" /></Style></ListView.ItemContainerStyle>
         <ListView.ItemTemplate><DataTemplate>
          <Border BorderBrush="{ThemeResource LineBrush}" BorderThickness="0,0,0,1" Padding="12,14">
           <Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="{Binding DetailColumnWidth}" /><ColumnDefinition Width="{Binding DetailColumnWidth}" /><ColumnDefinition Width="85" /></Grid.ColumnDefinitions>
            <StackPanel Spacing="4" VerticalAlignment="Center">
             <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding Name}" />
             <TextBlock Text="{Binding Id}" FontSize="12" Foreground="{ThemeResource MutedBrush}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding Id}" />
             <TextBlock Text="{Binding CompactDetail}" Visibility="{Binding CompactVisibility}" FontSize="12" Foreground="{ThemeResource MutedBrush}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <TextBlock Grid.Column="1" Text="{Binding Version}" Visibility="{Binding WideVisibility}" FontSize="12" Foreground="{ThemeResource MutedBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding Version}" />
            <TextBlock Grid.Column="2" Text="{Binding Source}" Visibility="{Binding WideVisibility}" FontSize="12" Foreground="{ThemeResource MutedBrush}" VerticalAlignment="Center" />
            <Button Grid.Column="3" Content="{Binding Action}" IsEnabled="{Binding CanInstall}" Click="InstallPackageClick" FontSize="12" Padding="12,6" HorizontalAlignment="Right" VerticalAlignment="Center" AutomationProperties.Name="{Binding InstallLabel}" ToolTipService.ToolTip="{Binding ActionDetail}" />
           </Grid>
          </Border>
         </DataTemplate></ListView.ItemTemplate>
        </ListView>
       </Grid>
       <StackPanel Visibility="{Binding EmptyVisibility}" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="400" Spacing="6" Padding="24">
        <TextBlock Text="{Binding SearchSummary}" FontSize="14" TextAlignment="Center" TextWrapping="Wrap" />
        <TextBlock Text="{Binding EmptyDetail}" Style="{StaticResource Muted}" TextAlignment="Center" />
       </StackPanel>
      </Grid>
      <StackPanel Grid.Row="3" Spacing="8" Visibility="{Binding InstallVisibility}">
       <StackPanel Orientation="Horizontal" Spacing="10"><ProgressRing IsActive="{Binding Installing}" Visibility="{Binding InstallProgressVisibility}" Width="14" Height="14" /><TextBlock Text="{Binding InstallTitle}" FontSize="13" TextWrapping="Wrap" /></StackPanel>
       <Expander Header="Details" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"><ScrollViewer MaxHeight="100"><TextBlock Text="{Binding InstallDetail}" FontSize="12" Foreground="{ThemeResource MutedBrush}" TextWrapping="Wrap" IsTextSelectionEnabled="True" /></ScrollViewer></Expander>
      </StackPanel>
     </Grid>
    </Grid>
    <Grid x:Name="LogsPage" Visibility="Collapsed" HorizontalAlignment="Stretch" RowSpacing="18">
     <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
     <Grid>
      <TextBlock Text="Logs" Style="{StaticResource PageTitle}" VerticalAlignment="Center" />
      <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
       <Button x:Name="CopyLogsButton" Click="CopyLogsClick" Padding="12,7" ToolTipService.ToolTip="Copy the entries shown" AutomationProperties.Name="Copy entries">
        <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE8C8;" FontSize="12" /><TextBlock x:Name="CopyLogsLabel" Text="Copy" FontSize="12" /></StackPanel>
       </Button>
       <Button Click="OpenLogsFolderClick" Padding="12,7" ToolTipService.ToolTip="Open the folder containing the log files" AutomationProperties.Name="Open log folder">
        <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE838;" FontSize="12" /><TextBlock x:Name="OpenLogsLabel" Text="Open folder" FontSize="12" /></StackPanel>
       </Button>
       <Button Click="ClearLogsClick" Padding="12,7" ToolTipService.ToolTip="Delete all saved entries" AutomationProperties.Name="Clear log">
        <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE74D;" FontSize="12" /><TextBlock x:Name="ClearLogsLabel" Text="Clear" FontSize="12" /></StackPanel>
       </Button>
      </StackPanel>
     </Grid>
     <Grid x:Name="LogFilters" Grid.Row="1" ColumnSpacing="10" RowSpacing="8">
      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition x:Name="LogSelectColumn" Width="320" /></Grid.ColumnDefinitions>
      <TextBox x:Name="LogSearch" PlaceholderText="Search entries" MaxLength="100" Height="38" VerticalContentAlignment="Center" TextChanged="LogFilterTextChanged" AutomationProperties.Name="Search entries" />
      <Grid x:Name="LogSelects" Grid.Column="1" ColumnSpacing="10">
       <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
       <ComboBox x:Name="LogLevelFilter" SelectedIndex="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" VerticalContentAlignment="Center" SelectionChanged="LogFilterChanged" AutomationProperties.Name="Severity">
        <ComboBoxItem Content="All activity" /><ComboBoxItem Content="Problems only" /><ComboBoxItem Content="Errors only" />
       </ComboBox>
       <ComboBox x:Name="LogAreaFilter" Grid.Column="1" SelectedIndex="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" VerticalContentAlignment="Center" SelectionChanged="LogFilterChanged" AutomationProperties.Name="Area">
        <ComboBoxItem Content="All areas" /><ComboBoxItem Content="Managers" /><ComboBoxItem Content="Search" /><ComboBoxItem Content="Install" /><ComboBoxItem Content="App" />
       </ComboBox>
      </Grid>
     </Grid>
     <StackPanel Grid.Row="2" Spacing="6">
      <TextBlock Text="{Binding Summary}" Style="{StaticResource Muted}" />
      <TextBlock Text="{Binding StorageWarning}" Visibility="{Binding StorageWarningVisibility}" FontSize="12" Foreground="{ThemeResource ErrorBrush}" TextWrapping="Wrap" />
     </StackPanel>
     <Grid Grid.Row="3">
      <ListView ItemsSource="{Binding Rows}" Visibility="{Binding ListVisibility}" SelectionMode="None" IsItemClickEnabled="False" Padding="0" HorizontalContentAlignment="Stretch" AutomationProperties.Name="Log entries">
       <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="0" /><Setter Property="MinHeight" Value="0" /><Setter Property="IsTabStop" Value="False" /></Style></ListView.ItemContainerStyle>
       <ListView.ItemTemplate><DataTemplate>
        <Border BorderBrush="{ThemeResource LineBrush}" BorderThickness="0,0,0,1" Padding="0,2">
         <Grid ColumnSpacing="4">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <Button Grid.Column="1" Click="CopyEntryClick" Margin="0,6,8,0" VerticalAlignment="Top" Width="32" Height="32" Padding="0" Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="Copy this entry" AutomationProperties.Name="Copy this entry">
           <FontIcon Glyph="{Binding CopyGlyph}" FontSize="13" />
          </Button>
         <StackPanel>
          <Button Click="LogRowClick" Background="Transparent" BorderThickness="0" Padding="12,11" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" CornerRadius="6" AutomationProperties.Name="{Binding Message}">
           <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="8" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <Ellipse Width="7" Height="7" Fill="{Binding DotBrush}" VerticalAlignment="Top" Margin="0,5,0,0" AutomationProperties.AccessibilityView="Raw" />
            <StackPanel Grid.Column="1" Spacing="3">
             <TextBlock Text="{Binding Message}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Left" />
             <TextBlock Text="{Binding Meta}" FontSize="12" Foreground="{ThemeResource MutedBrush}" TextWrapping="Wrap" TextAlignment="Left" ToolTipService.ToolTip="{Binding Exact}" />
            </StackPanel>
            <FontIcon Grid.Column="2" Glyph="{Binding Chevron}" Visibility="{Binding ChevronVisibility}" FontSize="11" Foreground="{ThemeResource MutedBrush}" VerticalAlignment="Top" Margin="0,4,0,0" />
           </Grid>
          </Button>
          <Border Visibility="{Binding DetailVisibility}" Background="{ThemeResource BadgeBrush}" CornerRadius="6" Padding="10,8" Margin="32,0,12,10">
           <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <TextBlock Text="{Binding Detail}" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
           </ScrollViewer>
          </Border>
         </StackPanel>
         </Grid>
        </Border>
       </DataTemplate></ListView.ItemTemplate>
      </ListView>
      <StackPanel Visibility="{Binding EmptyVisibility}" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="400" Spacing="6" Padding="24">
       <TextBlock Text="{Binding EmptyTitle}" FontSize="14" TextAlignment="Center" TextWrapping="Wrap" />
       <TextBlock Text="{Binding EmptyDetail}" Style="{StaticResource Muted}" TextAlignment="Center" />
      </StackPanel>
     </Grid>
    </Grid>
   </Grid>
  </Grid>
 </Grid>
</Window>

