<Window x:Class="TidyWindow.Next.Desktop.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="TidyWindow">
 <Grid x:Name="Root" RequestedTheme="Dark" Background="{StaticResource CanvasBrush}">
  <Grid.KeyboardAccelerators><KeyboardAccelerator Key="K" Modifiers="Control" Invoked="SearchShortcut" /></Grid.KeyboardAccelerators>
  <Grid.RowDefinitions><RowDefinition Height="40" /><RowDefinition Height="*" /></Grid.RowDefinitions>
  <Grid x:Name="TitleBar" Padding="20,0,140,0">
   <TextBlock Text="TidyWindow" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
  </Grid>
  <Grid Grid.Row="1">
   <Grid.ColumnDefinitions><ColumnDefinition x:Name="SidebarColumn" Width="184" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
   <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0">
    <StackPanel Margin="10,20,10,0" Spacing="4">
     <Button x:Name="OverviewNav" Style="{StaticResource NavButton}" Click="OverviewClick" ToolTipService.ToolTip="Overview" AutomationProperties.Name="Overview">
      <StackPanel Orientation="Horizontal" Spacing="10"><FontIcon Glyph="&#xE80F;" FontSize="15" /><TextBlock x:Name="OverviewLabel" Text="Overview" FontSize="13" /></StackPanel>
     </Button>
     <Button x:Name="InstallNav" Style="{StaticResource NavButton}" Click="InstallClick" ToolTipService.ToolTip="Install apps (Ctrl+K)" AutomationProperties.Name="Install Hub">
      <StackPanel Orientation="Horizontal" Spacing="10"><FontIcon Glyph="&#xE7B8;" FontSize="15" /><TextBlock x:Name="InstallLabel" Text="Install Hub" FontSize="13" /></StackPanel>
     </Button>
    </StackPanel>
   </Border>
   <Grid x:Name="ContentArea" Grid.Column="1" Padding="36,24,36,28">
    <ScrollViewer x:Name="OverviewPage" HorizontalContentAlignment="Stretch" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
     <StackPanel HorizontalAlignment="Stretch" Spacing="24">
      <Grid>
       <TextBlock Text="Package managers" Style="{StaticResource PageTitle}" VerticalAlignment="Center" />
       <Button HorizontalAlignment="Right" Click="RefreshClick" IsEnabled="{Binding CanRefresh}" Padding="12,7">
        <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE72C;" FontSize="12" /><TextBlock Text="Refresh" FontSize="12" /></StackPanel>
       </Button>
      </Grid>
      <Grid>
       <Border Style="{StaticResource Card}" Padding="0">
        <ItemsControl ItemsSource="{Binding Managers}" AutomationProperties.Name="Package managers">
         <ItemsControl.ItemTemplate><DataTemplate>
          <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="18,18">
           <Grid ColumnSpacing="14">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /><ColumnDefinition Width="{Binding StatusColumnWidth}" /><ColumnDefinition Width="{Binding SetupColumnWidth}" /></Grid.ColumnDefinitions>
            <Border Grid.RowSpan="2" Background="#202020" CornerRadius="6" Width="32" Height="32"><TextBlock Text="{Binding Mark}" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
             <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" />
             <TextBlock Text="{Binding Version}" FontSize="12" Foreground="{StaticResource MutedBrush}" />
            </StackPanel>
            <Button Grid.Column="{Binding StatusColumn}" Grid.Row="{Binding StatusRow}" Background="Transparent" BorderThickness="0" Padding="0,4" VerticalAlignment="Center" HorizontalAlignment="Left" ToolTipService.ToolTip="Status details">
             <StackPanel Orientation="Horizontal" Spacing="7"><Ellipse Width="5" Height="5" Fill="{Binding StatusBrush}" /><TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="{Binding StatusBrush}" /></StackPanel>
             <Button.Flyout><Flyout><ScrollViewer MaxHeight="220" MaxWidth="420"><TextBlock Text="{Binding Detail}" TextWrapping="Wrap" IsTextSelectionEnabled="True" FontSize="12" /></ScrollViewer></Flyout></Button.Flyout>
            </Button>
            <Button Grid.Column="3" Grid.RowSpan="2" Content="Set up ↗" Visibility="{Binding SetupVisibility}" Click="ManagerGuideClick" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="12" Padding="10,6" />
           </Grid>
          </Border>
         </DataTemplate></ItemsControl.ItemTemplate>
        </ItemsControl>
       </Border>
       <ProgressBar x:Name="DetectionProgress" IsIndeterminate="True" Visibility="Collapsed" Height="2" VerticalAlignment="Top" />
      </Grid>
     </StackPanel>
    </ScrollViewer>
    <Grid x:Name="InstallPage" Visibility="Collapsed" HorizontalAlignment="Stretch" RowSpacing="22">
     <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
     <TextBlock Text="Install apps" Style="{StaticResource PageTitle}" />
     <Grid x:Name="SearchControls" Grid.Row="1" ColumnSpacing="10" RowSpacing="8">
      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition x:Name="FilterColumn" Width="150" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <TextBox x:Name="SearchBox" PlaceholderText="Search apps or package IDs" MaxLength="100" Height="38" VerticalContentAlignment="Center" TextChanged="SearchTextChanged" KeyDown="SearchKeyDown" AutomationProperties.Name="Search packages" />
      <ComboBox x:Name="SourceFilter" Grid.Column="1" SelectedIndex="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" VerticalContentAlignment="Center" SelectionChanged="SourceChanged" AutomationProperties.Name="Package source">
       <ComboBoxItem Content="All sources" /><ComboBoxItem Content="WinGet" /><ComboBoxItem Content="Chocolatey" /><ComboBoxItem Content="Scoop" />
      </ComboBox>
      <Button x:Name="SearchButton" Grid.Column="2" Content="Search" Click="SearchClick" Padding="16,8" Height="38" />
     </Grid>
     <Grid Grid.Row="2" RowSpacing="12">
      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
      <Grid Visibility="{Binding CancelVisibility}">
       <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
        <ProgressRing IsActive="{Binding Searching}" Width="14" Height="14" /><TextBlock Text="Searching…" FontSize="12" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
       </StackPanel>
       <Button Content="Cancel" Click="CancelSearchClick" HorizontalAlignment="Right" FontSize="12" Padding="10,4" />
      </Grid>
      <Expander Grid.Row="1" Header="Search needs attention" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Visibility="{Binding ErrorVisibility}">
       <ScrollViewer MaxHeight="120"><TextBlock Text="{Binding Errors}" TextWrapping="Wrap" FontSize="12" Foreground="#E3BB80" IsTextSelectionEnabled="True" /></ScrollViewer>
      </Expander>
      <Grid Grid.Row="2">
       <Grid Visibility="{Binding ResultsVisibility}">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Border Visibility="{Binding ResultsHeaderVisibility}" Height="36" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="12,0">
         <Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="100" /><ColumnDefinition Width="100" /><ColumnDefinition Width="85" /></Grid.ColumnDefinitions>
          <TextBlock Text="Name" Style="{StaticResource Muted}" VerticalAlignment="Center" />
          <TextBlock Grid.Column="1" Text="Version" Style="{StaticResource Muted}" VerticalAlignment="Center" />
          <TextBlock Grid.Column="2" Text="Source" Style="{StaticResource Muted}" VerticalAlignment="Center" />
         </Grid>
        </Border>
        <ListView Grid.Row="1" ItemsSource="{Binding Packages}" SelectionMode="None" IsItemClickEnabled="False" Padding="0" HorizontalContentAlignment="Stretch" AutomationProperties.Name="Package search results">
         <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="0" /><Setter Property="MinHeight" Value="0" /></Style></ListView.ItemContainerStyle>
         <ListView.ItemTemplate><DataTemplate>
          <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="12,14">
           <Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="{Binding DetailColumnWidth}" /><ColumnDefinition Width="{Binding DetailColumnWidth}" /><ColumnDefinition Width="85" /></Grid.ColumnDefinitions>
            <StackPanel Spacing="4" VerticalAlignment="Center">
             <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding Name}" />
             <TextBlock Text="{Binding Id}" FontSize="12" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding Id}" />
             <TextBlock Text="{Binding CompactDetail}" Visibility="{Binding CompactVisibility}" FontSize="12" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <TextBlock Grid.Column="1" Text="{Binding Version}" Visibility="{Binding WideVisibility}" FontSize="12" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding Version}" />
            <TextBlock Grid.Column="2" Text="{Binding Source}" Visibility="{Binding WideVisibility}" FontSize="12" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
            <Button Grid.Column="3" Content="{Binding Action}" IsEnabled="{Binding CanInstall}" Click="InstallPackageClick" FontSize="12" Padding="12,6" HorizontalAlignment="Right" VerticalAlignment="Center" AutomationProperties.Name="{Binding InstallLabel}" ToolTipService.ToolTip="{Binding ActionDetail}" />
           </Grid>
          </Border>
         </DataTemplate></ListView.ItemTemplate>
        </ListView>
       </Grid>
       <StackPanel Visibility="{Binding EmptyVisibility}" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="400" Spacing="6" Padding="24">
        <TextBlock Text="{Binding SearchSummary}" FontSize="14" TextAlignment="Center" TextWrapping="Wrap" />
        <TextBlock Text="{Binding EmptyDetail}" Style="{StaticResource Muted}" TextAlignment="Center" />
       </StackPanel>
      </Grid>
      <StackPanel Grid.Row="3" Spacing="8" Visibility="{Binding InstallVisibility}">
       <StackPanel Orientation="Horizontal" Spacing="10"><ProgressRing IsActive="{Binding Installing}" Visibility="{Binding InstallProgressVisibility}" Width="14" Height="14" /><TextBlock Text="{Binding InstallTitle}" FontSize="13" TextWrapping="Wrap" /></StackPanel>
       <Expander Header="Details" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"><ScrollViewer MaxHeight="100"><TextBlock Text="{Binding InstallDetail}" FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" IsTextSelectionEnabled="True" /></ScrollViewer></Expander>
      </StackPanel>
     </Grid>
    </Grid>
   </Grid>
  </Grid>
 </Grid>
</Window>
