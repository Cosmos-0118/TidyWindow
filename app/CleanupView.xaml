<UserControl x:Class="TidyWindow.Next.Desktop.CleanupView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="using:TidyWindow.Next.Desktop"
 HorizontalContentAlignment="Stretch">
 <Grid RowSpacing="16">
  <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
  <Grid ColumnSpacing="10">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
   <TextBlock Text="Cleanup" Style="{StaticResource PageTitle}" VerticalAlignment="Center" />
   <Button Grid.Column="1" Click="ScanClick" IsEnabled="{Binding CanScan}" Padding="12,7">
    <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE72C;" FontSize="12" /><TextBlock Text="{Binding ScanLabel}" FontSize="12" /></StackPanel>
   </Button>
   <Button Grid.Column="2" Click="CleanClick" IsEnabled="{Binding CanClean}" Style="{StaticResource AccentButtonStyle}" Padding="14,7" AutomationProperties.Name="Clean the selected items">
    <TextBlock Text="{Binding CleanLabel}" FontSize="12" />
   </Button>
  </Grid>
  <StackPanel Grid.Row="1" Spacing="10">
   <TextBlock Text="{Binding Status}" FontSize="12" Foreground="{ThemeResource MutedBrush}" TextWrapping="Wrap" />
   <Border Style="{StaticResource Card}" Padding="14,10" Visibility="{Binding SummaryVisibility}">
    <TextBlock Text="{Binding Summary}" FontSize="13" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
   </Border>
   <Button Click="UndoClick" Visibility="{Binding UndoVisibility}" IsEnabled="{Binding CanScan}" Padding="12,7" FontSize="12" HorizontalAlignment="Left">
    <TextBlock Text="{Binding UndoText}" FontSize="12" />
   </Button>
  </StackPanel>
  <Grid Grid.Row="2">
   <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Spacing="18" Padding="0,0,0,8">
     <ItemsControl ItemsSource="{Binding Groups}" AutomationProperties.Name="Things that can be cleaned">
      <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="18" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate><DataTemplate>
       <StackPanel Spacing="8">
        <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource MutedBrush}" />
        <Border Style="{StaticResource Card}" Padding="0">
         <ItemsControl ItemsSource="{Binding Rows}">
          <ItemsControl.ItemTemplate><DataTemplate>
           <Border BorderBrush="{ThemeResource LineBrush}" BorderThickness="0,0,0,1">
            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" MinWidth="0" Padding="12,0,0,0" Margin="14,0,14,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center" AutomationProperties.Name="{Binding AutomationName}">
             <Grid ColumnSpacing="14" Padding="0,12">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <StackPanel Spacing="3" VerticalAlignment="Center">
               <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" local:TrimTip.Enabled="True" />
                <Border Visibility="{Binding ReviewVisibility}" Background="{ThemeResource BadgeBrush}" CornerRadius="4" Padding="6,1" VerticalAlignment="Center">
                 <TextBlock Text="{Binding ReviewText}" FontSize="11" Foreground="{ThemeResource MutedBrush}" />
                </Border>
               </StackPanel>
               <TextBlock Text="{Binding Detail}" FontSize="12" Foreground="{ThemeResource MutedBrush}" TextWrapping="Wrap" />
              </StackPanel>
              <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" Spacing="2">
               <TextBlock Text="{Binding SizeText}" FontSize="13" FontWeight="SemiBold" TextAlignment="Right" />
               <TextBlock Text="{Binding FilesText}" FontSize="11" Foreground="{ThemeResource MutedBrush}" TextAlignment="Right" />
              </StackPanel>
             </Grid>
            </CheckBox>
           </Border>
          </DataTemplate></ItemsControl.ItemTemplate>
         </ItemsControl>
        </Border>
       </StackPanel>
      </DataTemplate></ItemsControl.ItemTemplate>
     </ItemsControl>
     <TextBlock Text="{Binding AdminNote}" Visibility="{Binding AdminVisibility}" FontSize="12" Foreground="{ThemeResource MutedBrush}" TextWrapping="Wrap" />
    </StackPanel>
   </ScrollViewer>
   <StackPanel Visibility="{Binding EmptyVisibility}" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="380" Padding="24" Spacing="6">
    <TextBlock Text="Nothing to clean right now" FontSize="14" TextAlignment="Center" />
    <TextBlock Text="Your caches and temporary files are already tidy." Style="{StaticResource Muted}" TextAlignment="Center" />
   </StackPanel>
   <local:LoadingOverlay IsActive="{Binding ScanOverlay}" Text="Looking for things to clean…" />
  </Grid>
 </Grid>
</UserControl>
